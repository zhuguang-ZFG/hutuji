/** LiMa 官网同源：深空底 + 青光主色（www.donglicao.com） */
page {
  background: #0b0c13;
  color: #f2f4f8;
  font-size: 28rpx;
  --bg: #0b0c13;
  --panel: #14151f;
  --panel-2: #1a1b28;
  --line: rgba(255, 255, 255, 0.08);
  --text: #f2f4f8;
  --muted: #9aa3b5;
  --cyan: #00d1e5;
  --cyan-dim: rgba(0, 209, 229, 0.16);
  --danger: #ff5c6a;
  --ok: #00d1e5;
}

.card {
  background: var(--panel);
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 24rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 12rpx 48rpx rgba(0, 209, 229, 0.08);
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
}

.card-sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 20rpx;
}

.btn-primary {
  background: var(--cyan) !important;
  color: #061016 !important;
  border-radius: 999rpx !important;
  font-size: 30rpx !important;
  font-weight: 600 !important;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: transparent !important;
  color: var(--cyan) !important;
  border: 2rpx solid rgba(0, 209, 229, 0.45) !important;
  border-radius: 999rpx !important;
  font-size: 30rpx !important;
}

.btn-ghost::after {
  border: none;
}

.btn-danger-ghost {
  background: transparent !important;
  color: var(--danger) !important;
  border: 2rpx solid rgba(255, 92, 106, 0.55) !important;
  border-radius: 999rpx !important;
  font-size: 30rpx !important;
}

.btn-danger-ghost::after {
  border: none;
}

.chip {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: var(--cyan-dim);
  color: var(--cyan);
}

.chip.warn {
  background: rgba(255, 184, 77, 0.16);
  color: #ffb84d;
}

.chip.err {
  background: rgba(255, 92, 106, 0.16);
  color: var(--danger);
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}
