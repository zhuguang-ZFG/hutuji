/** LiMa 官网同源：深空底 + 青光主色（www.donglicao.com） */
page {
  background: #0b0c13;
  color: #f2f4f8;
  font-size: 28rpx;
  --bg: #0b0c13;
  --panel: #14151f;
  --panel-2: #1a1b28;
  --line: rgba(255, 255, 255, 0.08);
  --text: #f2f4f8;
  --muted: #9aa3b5;
  --cyan: #00d1e5;
  --cyan-dim: rgba(0, 209, 229, 0.16);
  --danger: #ff5c6a;
  --ok: #00d1e5;
}

.card {
  background: var(--panel);
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 24rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 12rpx 48rpx rgba(0, 209, 229, 0.08);
}


.muted {
  color: var(--muted);
  font-size: 24rpx;
}
