.del-btn,
.speed-retry,
.connection-refresh,
.paper-option,
.toolbox,
.symmetry-group,
.symmetry-btn,
.draw-tool,
.selection-tools button,
.history-btn,
.clear-btn {
  color: #4d3a46 !important;
  background: #fdefe4 !important;
  border-color: rgba(77, 58, 70, 0.25) !important;
}

.mode-tab.active,
.chip-on,
.preset.selected,
.model-on,
.version-switch .selected,
.cat-chip.active,
.paper-option.selected,
.creative-toggle.selected,
.symmetry-btn.active,
.draw-tool.active,
.dpad-btn.home,
.msg-row.user .bubble {
  color: #fffdf8 !important;
  background: #6b4e5e !important;
  border-color: #6b4e5e !important;
}

.action-tile:nth-child(3n + 1) .tile-icon { background: #ffe0e8 !important; }

.action-tile:nth-child(3n + 2) .tile-icon { background: #bfe4d7 !important; }

.action-tile:nth-child(3n) .tile-icon { background: #fff0bd !important; }

.status-dot.ok,
.device-dot.connected,
.timeline-step.done .timeline-dot,
.draft-dot {
  background: #6ea998 !important;
}

.timeline-step.active .timeline-dot,
.page-bar-fill,
.progress-fill,
.thinking-dots view,
.eye {
  background: #d85f7b !important;
}

.companion-face {
  overflow: visible;
  border: 3rpx solid #6b4e5e !important;
  border-radius: 36rpx 42rpx 34rpx 40rpx !important;
  background: linear-gradient(145deg, #fffdf8, #ffe4eb) !important;
  box-shadow: 4rpx 6rpx 0 rgba(168, 213, 198, 0.30);
}

.companion-face::before,
.companion-face::after {
  content: "";
  position: absolute;
  top: -11rpx;
  width: 25rpx;
  height: 29rpx;
  border: 3rpx solid #6b4e5e;
  border-bottom: 0;
  background: #f3a3b5;
  z-index: -1;
}

.companion-face::before {
  left: 7rpx;
  border-radius: 20rpx 6rpx 10rpx 6rpx;
  transform: rotate(-24deg);
}

.companion-face::after {
  right: 7rpx;
  border-radius: 6rpx 20rpx 6rpx 10rpx;
  transform: rotate(24deg);
}

.companion-face .eye { background: #6b4e5e !important; }

.companion-face .smile { border-color: #d85f7b; }

.bubble,
.preview-card,
.draw-card {
  color: #4d3a46;
  background: #fffdf8 !important;
  border-color: rgba(77, 58, 70, 0.20) !important;
}

.welcome {
  margin: 18rpx 26rpx 0;
  border: 2rpx dashed rgba(216, 95, 123, 0.28);
  border-radius: 30rpx 38rpx 28rpx 36rpx;
  background: linear-gradient(150deg, #fffdf8, #fff0f4 58%, #eef9f4);
}

@keyframes pai-float {
  0%, 100% { transform: translateY(0) rotate(4deg); }
  50% { transform: translateY(-5rpx) rotate(-2deg); }
}

@keyframes pai-blink {
  0%, 44%, 48%, 100% { transform: scaleY(1); }
  46% { transform: scaleY(0.12); }
}
