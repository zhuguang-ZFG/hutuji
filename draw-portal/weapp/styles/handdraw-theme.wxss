  background: #f5e1d4 !important;
  border-color: rgba(141, 62, 53, 0.3) !important;
}

.skeleton-row,
.sk-thumb,
.sk-line,
.preview-placeholder,
.loading-line {
  background: #eadfce !important;
}

.cat-chip {
  color: #756d61 !important;
  background: #eadfce !important;
  border-color: rgba(38, 56, 74, 0.24) !important;
}

.cat-chip.active {
  color: #fffaf0 !important;
  background: #26384a !important;
}

.section-tip,
.field-help {
  color: #81786b !important;
}

slider {
  --weui-BRAND: #b84c3f;
}

.btn-press,
.tile-press,
.row-press,
.card-press,
.button-press,
.dpad-press {
  opacity: 0.82;
  transform: translate(2rpx, 2rpx);
}

/* 独立全屏画板：沿用纸本色，但保留原有紧凑工具布局。 */
.studio-head,
.paper-meta,
.creative-head,
.tool-bottom,
.selection-tools {
  border-color: rgba(38, 56, 74, 0.18) !important;
}

.studio-title,
.studio-sub,
.draft-state,
.stroke-count,
.tool-hint,
.foot-note,
.paper-link,
.paper-link text,
.creative-toggle,
.replay-btn {
  color: #756d61 !important;
}

.studio-title {
  color: #26384a !important;
  font-family: "STKaiti", "KaiTi", serif;
}

.draft-dot {
  background: #65785e !important;
}

.paper-option,
.toolbox,
.symmetry-group,
.symmetry-btn,
.draw-tool,
.selection-tools button,
.history-btn,
.clear-btn {
  color: #756d61 !important;
  background: #efe3d2 !important;
  border-color: rgba(38, 56, 74, 0.28) !important;
}

.paper-option.selected,
.creative-toggle.selected,
.symmetry-btn.active,
.draw-tool.active {
  color: #fffaf0 !important;
  background: #26384a !important;
  border-color: #26384a !important;
}

.toolbox {
  border: 2rpx solid rgba(38, 56, 74, 0.38) !important;
  border-radius: 18rpx 24rpx 17rpx 23rpx !important;
  box-shadow: 5rpx 6rpx 0 rgba(38, 56, 74, 0.07);
}

.paper {
  box-shadow: 7rpx 9rpx 0 rgba(38, 56, 74, 0.13) !important;
}

.paper-notice {
  color: #5f7259 !important;
  background: #e4eadc !important;
  border: 1rpx solid rgba(95, 114, 89, 0.28);
}

.paper-notice.warn,
.canvas-error {
  color: #8d3e35 !important;
  background: #f5e1d4 !important;
}

.converting {
  color: #26384a !important;
  background: rgba(255, 250, 240, 0.93) !important;
}

.preview-btn {
  color: #fffaf0 !important;
  background: #b84c3f !important;
  border: 2rpx solid #7f342e !important;
  box-shadow: 4rpx 5rpx 0 rgba(38, 56, 74, 0.13);
}

.preview-btn[disabled] {
  color: #aaa091 !important;
  background: #dfd2bf !important;
  border-color: #c7b9a5 !important;
}

/* 绑定、配网、升级与分享页也使用同一套纸本语义，避免流程中途退回深色旧主题。 */
.code-input,
.model-item {
  color: #26384a !important;
  background: #fffdf7 !important;
  border-color: rgba(38, 56, 74, 0.28) !important;
}

.divider-text,
.work-date,
.failed-sub,
.loading-label,
.progress-meta,
.status-tip,
.model-desc,
.credit-change,
.credit-link,
.tips {
  color: #81786b !important;
}

.failed-title,
.progress-label,
.model-name {
  color: #26384a !important;
}

.log {
  color: #26384a !important;
  background: #efe3d2 !important;
  border: 2rpx dashed rgba(38, 56, 74, 0.34) !important;
}

.progress-wrap,
.model-item {
  background: #fffaf0 !important;
  border: 2rpx solid rgba(38, 56, 74, 0.3) !important;
  box-shadow: 4rpx 5rpx 0 rgba(38, 56, 74, 0.06) !important;
}

.badge,
.highlight .weui-cell__ft,
.status-tip.ok,
.bound-ok,
.bind-help,
.password-toggle {
  color: #5f7259 !important;
}

.badge {
  background: #e4eadc !important;
  border: 1rpx solid rgba(95, 114, 89, 0.3) !important;
}

.bind-btn,
.save-btn.save-on,
.retry-btn {
  color: #fffaf0 !important;
  background: #b84c3f !important;
  border: 2rpx solid #7f342e !important;
}

.save-btn:not(.save-on) {
  color: #81786b !important;
  background: #dfd2bf !important;
}

/* 对话页保留角色区分，但把所有承载面收回纸张、墨蓝和朱砂三色。 */
.chat-page .suggestion,
.preview-card,
.draw-card,
.chat-page .input-toggle,
.chat-page .mic-enable,
.chat-page .msg-restore,
.chat-page .load-error button {
