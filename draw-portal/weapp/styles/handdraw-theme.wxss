/*
 * 全站手绘主题（单层）：handraw-style FH-031 小红书奶油手绘。
 * 上游：https://github.com/yang0/handraw-style（作者 yang0）。
 * 令牌：奶油 #fff7ed/#fffdf8 承载，珊瑚粉 #f3a3b5/#d85f7b 只作填充与描边，
 * 文字用暖莓 #4d3a46、次要 #735f69、深珊瑚 #b03f5a、深薄荷 #3b7564、错误 #a3354d；
 * 承载正文的文字色在奶油面上须 ≥4.5:1（tests/weapp/handdraw_theme.test.js 钉住）。
 * !important 仅用于压过页面旧规则与 button/input 等内置组件默认样式。
 */
page,
.page,
.market-page,
.detail-page,
.paper-settings,
.studio {
  background: #fff7ed !important;
  color: #4d3a46;
}

.page { position: relative; }

button,
input,
textarea,
picker,
slider {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button::after { border: none !important; }

/* 只改视觉、不触碰页面状态机或设备动作逻辑；“小派”头像贯穿各页作记忆点。 */
.hero,
.atelier-head {
  position: relative;
  overflow: hidden;
  margin: 26rpx 26rpx 18rpx;
  padding: 34rpx 32rpx 32rpx;
  border: 2rpx solid rgba(77, 58, 70, 0.56);
  border-radius: 20rpx 30rpx 22rpx 26rpx;
  min-height: 176rpx;
  padding-right: 150rpx;
  border-color: rgba(77, 58, 70, 0.26);
  background: linear-gradient(145deg, #fffdf8 0%, #fff0f4 56%, #eef9f4 100%);
  box-shadow: 8rpx 10rpx 0 rgba(216, 95, 123, 0.10);
}

.hero::after,
.atelier-head::after {
  content: "";
  position: absolute;
  border: 4rpx solid rgba(216, 95, 123, 0.24);
  border-radius: 50%;
  transform: rotate(-12deg);
  right: -12rpx;
  bottom: -24rpx;
  width: 190rpx;
  height: 100rpx;
  border-color: rgba(243, 163, 181, 0.34);
}

.atelier-kicker,
.hero-brand,
.eyebrow,
.weui-cells__title {
  font-size: 22rpx !important;
  font-weight: 700 !important;
  letter-spacing: 3rpx !important;
  color: #b03f5a !important;
}

.atelier-title {
  display: block;
  margin-top: 10rpx;
  font-size: 50rpx;
  line-height: 1.25;
  letter-spacing: 2rpx;
}

.atelier-mark {
  position: absolute;
  right: 42rpx;
  top: 34rpx;
  width: 72rpx;
  height: 72rpx;
  border: 4rpx solid #d85f7b;
  border-radius: 12rpx 18rpx 10rpx 16rpx;
  color: #b03f5a;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
  transform: rotate(6deg);
  opacity: 0.88;
}

.atelier-line {
  width: 132rpx;
  height: 10rpx;
  margin-top: 22rpx;
  border-top: 4rpx solid #e2b75d;
  border-radius: 50%;
  transform: rotate(-2deg);
  border-color: #e2b75d;
}

.weui-cells,
.input-panel,
.preview-card,
.status-card,
.jog-block,
.speed-block,
.offline-card,
.settings-panel,
.paper-scene,
.send-panel,
.credit-panel,
.section,
.sk-panel,
.work-cell,
.gallery-card,
.paper-frame,
.draft-notice,
.history-notice,
.generation-note,
.bind-banner {
  border: 2rpx solid rgba(77, 58, 70, 0.34) !important;
}

.weui-cells,
.input-panel,
.status-card,
.jog-block,
.speed-block,
.offline-card,
.settings-panel,
.paper-scene,
.send-panel,
.credit-panel,
.section,
.sk-panel {
  border-radius: 18rpx 24rpx 20rpx 26rpx !important;
}

.weui-cell + .weui-cell::before,
.divider-line {
  background: rgba(77, 58, 70, 0.14);
  border-color: rgba(77, 58, 70, 0.14) !important;
}

/* 操作行只要分隔线；整行灰底会把透明按钮上的次要字压到 4.5:1 以下。 */
.row-actions { border-color: rgba(77, 58, 70, 0.14) !important; }

.weui-cell__bd,
.nick-input,
.name,
.status-main,
.status-state,
.jog-label,
.speed-label,
.speed-axis-label,
.paper-summary-title,
.message-author,
.card-caption,
.draw-desc,
.picked,
.setting-row,
.device-row,
.credit-text,
.notice-title {
  color: #4d3a46 !important;
}

.muted,
.weui-cell__ft,
.weui-cells__tips,
.input-caption,
.example-row,
.result-count,
.preview-meta,
.timeline-hint,
.timeline-lab,
.eta-row,
.ota-line,
.page-bar-meta,
.speed-hint,
.offline-sub,
.phone-text,
.support-email,
.preview-tip,
.action-hint,
.mapping,
.page-foot,
.voice-hint,
.ai-note {
  color: #735f69 !important;
}

.weui-btn,
.connection-refresh {
  border-radius: 14rpx 18rpx 13rpx 17rpx !important;
  box-shadow: 4rpx 5rpx 0 rgba(77, 58, 70, 0.13);
}

.empty-action,
.send-btn,
.send-button,
.go-btn,
.confirm-btn,
.text-send,
.btn-confirm,
.draw-btn,
.save-button {
  border-radius: 14rpx 18rpx 13rpx 17rpx !important;
}

.weui-btn_primary,
.empty-action,
.send-btn,
.send-button,
.go-btn,
.confirm-btn,
.text-send,
.btn-confirm,
.draw-btn,
.save-button {
  border: 2rpx solid #d85f7b !important;
}

.weui-btn_primary:not([disabled]):active,
.empty-action:active,
.send-button:active,
.go-btn:active {
  background: #eb8fa5 !important;
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 3rpx 0 rgba(77, 58, 70, 0.12);
}

.weui-btn_default,
.favorite-button,
.retry-button,
.btn-cancel,
.job-btn,
.pen-btn,
.dpad-btn,
.step-pill,
.preset,
.chip,
.suggestion,
.input-toggle,
.mic-enable,
.search-clear,
.search-sort,
.redraw-btn,
.del-btn,
.speed-retry,
.connection-refresh {
  border: 2rpx solid rgba(77, 58, 70, 0.38) !important;
}

.weui-btn_warn,
.danger,
.logout-btn {
  color: #a3354d !important;
  background: rgba(216, 95, 123, 0.06) !important;
  border-color: rgba(200, 86, 104, 0.42) !important;
}

.weui-btn[disabled],
button[disabled] {
  opacity: 0.44 !important;
  box-shadow: none !important;
}

.field,
.work-search,
.cell-input,
.compact-input,
.dimension-inputs input,
.font-picker-val,
.group-picker,
.weui-textarea,
textarea,
input {
  color: #4d3a46 !important;
  background: #fffdf8 !important;
  border-color: rgba(77, 58, 70, 0.28) !important;
}

.ph { color: #9a8590 !important; }

.version-switch,
.chips,
.presets,
.voice-grid {
  background: transparent;
}

.mode-segment {
  margin: 22rpx 26rpx 10rpx !important;
  padding: 8rpx !important;
  border: 2rpx solid rgba(77, 58, 70, 0.34) !important;
  border-radius: 18rpx !important;
  background: #f8e7d9 !important;
  border-color: rgba(77, 58, 70, 0.20) !important;
}

.mode-tab {
  color: #735f69 !important;
  border-radius: 12rpx 16rpx 11rpx 15rpx !important;
}

.mode-tab.active,
.chip-on,
.preset.selected,
.model-on,
.version-switch .selected {
  box-shadow: 3rpx 4rpx 0 rgba(216, 95, 123, 0.2) !important;
}

.paper-summary,
.control-paper-link {
  border: 2rpx dashed rgba(77, 58, 70, 0.42) !important;
  border-radius: 15rpx 20rpx 16rpx 22rpx !important;
  background: #fdefe4 !important;
  border-color: rgba(216, 95, 123, 0.38) !important;
}

.paper-summary-sheet {
  border-color: #d85f7b;
  background: #fffdf8;
  box-shadow: 3rpx 3rpx 0 rgba(77, 58, 70, 0.12);
}

.paper-summary-sheet::after { border-color: rgba(77, 58, 70, 0.44); }

.paper-summary-detail,
.paper-summary-hint,
.paper-summary-arrow,
.control-paper-link {
  color: #735f69 !important;
}

.action-grid { gap: 18rpx !important; }

.action-tile {
  position: relative;
  overflow: hidden;
  background: #fffdf8 !important;
  border: 2rpx solid rgba(77, 58, 70, 0.4) !important;
  border-radius: 18rpx 24rpx 17rpx 22rpx !important;
  box-shadow: 5rpx 7rpx 0 rgba(77, 58, 70, 0.08) !important;
}

.action-tile::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 12rpx;
  width: 24rpx;
  height: 8rpx;
  border-top: 3rpx solid rgba(226, 183, 93, 0.7);
  transform: rotate(-8deg);
}

.tile-label,
.bind-title,
.result-title,
.refine-waiting-title {
  color: #4d3a46 !important;
}

.tile-icon,
.empty-glyph,
.intro-art {
  border-color: rgba(77, 58, 70, 0.5) !important;
  box-shadow: none !important;
}

.bind-banner.market-banner { background: #f8e7d9 !important; }

.work-title + .card-arrow { color: #b03f5a !important; }

.preview,
.preview-img,
.thumb,
.card-paper,
.work-preview,
.sheet {
  background: #fffdf8 !important;
  border: 2rpx solid rgba(77, 58, 70, 0.32) !important;
  border-radius: 12rpx 18rpx 14rpx 20rpx !important;
  box-shadow: 4rpx 6rpx 0 rgba(77, 58, 70, 0.08) !important;
}

.work-cell,
.gallery-card {
  border-radius: 16rpx 23rpx 18rpx 25rpx !important;
}

.gallery-card:nth-child(2n),
.work-cell:nth-child(2n) {
  transform: rotate(0.35deg);
}

.gallery-card:nth-child(3n),
.work-cell:nth-child(3n) {
  transform: rotate(-0.3deg);
}

.status-dot,
.device-dot,
.timeline-dot {
  background: #c9b5bd !important;
  box-shadow: 0 0 0 5rpx rgba(143, 122, 132, 0.12);
}

.status-dot.ok,
.device-dot.connected,
.timeline-step.done .timeline-dot {
  box-shadow: 0 0 0 5rpx rgba(110, 169, 152, 0.16);
}

.status-dot.bad { background: #d85f7b !important; }

.page-bar-track,
.progress-bar {
  background: #f3dfc8 !important;
  border: 1rpx solid rgba(77, 58, 70, 0.2);
}

.job-btn.danger {
  color: #fffdf8 !important;
  background: #b5455c !important;
}

.chat-header,
.composer {
  box-shadow: 0 8rpx 24rpx rgba(77, 58, 70, 0.08);
  background: rgba(255, 253, 248, 0.97) !important;
  border-color: rgba(77, 58, 70, 0.15) !important;
}

.bubble {
  border: 2rpx solid rgba(77, 58, 70, 0.28);
  border-radius: 18rpx 22rpx 18rpx 8rpx !important;
  box-shadow: 4rpx 5rpx 0 rgba(77, 58, 70, 0.06);
}

.msg-row.user .bubble { border-radius: 22rpx 18rpx 8rpx 18rpx !important; }

.hold-btn.active {
  color: #fffdf8 !important;
  background: #6b4e5e !important;
}

.history-notice,
.generation-note,
.draft-notice {
  color: #a3354d !important;
}

.device-note,
.error-bar,
.load-error,
.control-error,
.speed-error,
.fit-error,
.share-feedback,
.preview-error,
.draw-state.warn {
  color: #a3354d !important;
  background: #fde7ea !important;
  border-color: rgba(200, 86, 104, 0.3) !important;
}

.skeleton-row,
.sk-thumb,
.sk-line,
.preview-placeholder,
.loading-line {
  background: #f8e7d9 !important;
}

.cat-chip {
  color: #735f69 !important;
  background: #f8e7d9;
  border-color: rgba(77, 58, 70, 0.24) !important;
}

.section-tip,
.field-help {
  color: #735f69 !important;
}

slider { --weui-brand: #d85f7b; }

.btn-press,
.tile-press,
.row-press,
.card-press,
.button-press,
.dpad-press {
  opacity: 0.82;
  transform: translate(2rpx, 2rpx);
}

/* 独立全屏画板：沿用纸本色，但保留原有紧凑工具布局。 */
.studio-head,
.paper-meta,
.creative-head,
.tool-bottom,
.selection-tools {
  border-color: rgba(77, 58, 70, 0.18) !important;
}

.studio-sub,
.draft-state,
.stroke-count,
.tool-hint,
.foot-note,
.paper-link,
.paper-link text,
.creative-toggle,
.replay-btn {
  color: #735f69 !important;
}

.studio-title {
  color: #4d3a46 !important;
  font-family: "STKaiti", "KaiTi", serif;
}

.toolbox {
  border: 2rpx solid rgba(77, 58, 70, 0.38) !important;
  border-radius: 18rpx 24rpx 17rpx 23rpx !important;
  box-shadow: 5rpx 6rpx 0 rgba(77, 58, 70, 0.07);
}

.paper { box-shadow: 7rpx 9rpx 0 rgba(77, 58, 70, 0.13) !important; }

.paper-notice {
  color: #3b7564 !important;
  background: #e3f3ec !important;
  border: 1rpx solid rgba(110, 169, 152, 0.28);
}

.paper-notice.warn,
.canvas-error {
  color: #a3354d !important;
  background: #fde7ea !important;
}

.converting {
  color: #4d3a46 !important;
  background: rgba(255, 253, 248, 0.93) !important;
}

.preview-btn { border: 2rpx solid #d85f7b !important; }

.preview-btn[disabled] {
  color: #9a8590 !important;
  background: #f3dfc8 !important;
  border-color: #e4c8d1 !important;
}

/* 绑定、配网、升级与分享页也使用同一套纸本语义，避免流程中途退回深色旧主题。 */
.code-input {
  color: #4d3a46 !important;
  background: #fffdf8 !important;
  border-color: rgba(77, 58, 70, 0.28) !important;
}

.model-item { color: #4d3a46; }

.divider-text,
.work-date,
.failed-sub,
.loading-label,
.progress-meta,
.status-tip,
.model-desc,
.credit-change,
.tips {
  color: #735f69 !important;
}

.failed-title,
.progress-label,
.model-name {
  color: #4d3a46 !important;
}

.log {
  color: #4d3a46 !important;
  background: #fdefe4 !important;
  border: 2rpx dashed rgba(77, 58, 70, 0.34);
}

.progress-wrap,
.model-item {
  border: 2rpx solid rgba(77, 58, 70, 0.3) !important;
}

.badge,
.highlight .weui-cell__ft,
.status-tip.ok,
.bound-ok,
.bind-help,
.password-toggle {
  color: #3b7564 !important;
}

.badge {
  background: #e3f3ec !important;
  border: 1rpx solid rgba(110, 169, 152, 0.3);
}

.bind-btn,
.save-btn.save-on,
.retry-btn {
  border: 2rpx solid #d85f7b !important;
}

.save-btn:not(.save-on) {
  color: #735f69 !important;
  background: #f3dfc8 !important;
}

/* 对话页保留角色区分，承载面统一回奶油纸色。 */
.chat-page .suggestion,
.chat-page .input-toggle,
.chat-page .mic-enable,
.chat-page .msg-restore,
.chat-page .load-error button {
  color: #4d3a46 !important;
  background: #fdefe4 !important;
  border-color: rgba(77, 58, 70, 0.32) !important;
}

.text-input {
  color: #4d3a46 !important;
  background: #fffdf8 !important;
  border-color: rgba(77, 58, 70, 0.34) !important;
}

/* .voice-status 不在此列：录音提示与取消提示由 chat.wxss 区分颜色。 */
.tool-traces,
.draw-state,
.reply-pending {
  color: #735f69 !important;
}

.smile { border-color: #d85f7b; }

.hold-btn.cancel {
  color: #fffdf8 !important;
  background: #b5455c !important;
}

/* 许可要求在产品中可见地保留作者与仓库地址。 */
.handraw-credit {
  background: #fffdf8;
  border: 2rpx solid rgba(77, 58, 70, 0.34);
  border-radius: 18rpx 24rpx 20rpx 26rpx;
  box-shadow: 6rpx 8rpx 0 rgba(77, 58, 70, 0.07);
}

.atelier-title,
.hero-title,
.slim-title,
.gallery-title,
.heading,
.empty-title,
.section-title,
.offline-title,
.work-title,
.settings-heading,
.companion-name,
.welcome-title {
  color: #4d3a46 !important;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 800 !important;
}

.atelier-copy,
.hero-sub,
.gallery-sub,
.empty-sub,
.section-desc,
.work-sub,
.companion-status,
.welcome-copy,
.welcome-kicker {
  color: #735f69 !important;
}

.pai-mascot {
  position: absolute;
  right: 30rpx;
  top: 28rpx;
  width: 104rpx;
  height: 104rpx;
  transform: rotate(4deg);
  animation: pai-float 3.2s ease-in-out infinite;
}

.pai-ear {
  position: absolute;
  top: 2rpx;
  width: 34rpx;
  height: 38rpx;
  border: 3rpx solid #6b4e5e;
  border-bottom: 0;
  background: #f3a3b5;
  transform: rotate(-22deg);
}

.pai-ear-left {
  left: 12rpx;
  border-radius: 28rpx 8rpx 16rpx 8rpx;
}

.pai-ear-right {
  right: 12rpx;
  border-radius: 8rpx 28rpx 8rpx 16rpx;
  transform: rotate(22deg);
}

.pai-face {
  position: absolute;
  left: 8rpx;
  top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  width: 88rpx;
  height: 76rpx;
  border: 3rpx solid #6b4e5e;
  border-radius: 42rpx 46rpx 38rpx 44rpx;
  background: #fffdf8;
  box-shadow: 4rpx 6rpx 0 rgba(216, 95, 123, 0.16);
}

.pai-eye {
  width: 12rpx;
  height: 21rpx;
  margin-top: -9rpx;
  border-radius: 50%;
  background: #6b4e5e;
  animation: pai-blink 5.6s infinite;
}

.pai-blush {
  position: absolute;
  top: 46rpx;
  width: 17rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(243, 163, 181, 0.72);
}

.pai-blush-left { left: 12rpx; }

.pai-blush-right { right: 12rpx; }

.pai-mouth {
  position: absolute;
  left: 37rpx;
  top: 48rpx;
  width: 14rpx;
  height: 7rpx;
  border: 3rpx solid #d85f7b;
  border-top: 0;
  border-radius: 0 0 14rpx 14rpx;
}

.pai-star {
  position: absolute;
  right: -8rpx;
  top: 5rpx;
  color: #e2b75d;
  font-size: 26rpx;
  font-weight: 800;
  transform: rotate(12deg);
}

.pai-mascot-thinking .pai-mouth {
  width: 9rpx;
  height: 9rpx;
  border: 3rpx solid #d85f7b;
  border-radius: 50%;
}

.pai-mascot-happy .pai-eye {
  height: 9rpx;
  border-radius: 50% 50% 0 0;
}

.pai-mascot-wink .pai-eye:first-child {
  height: 4rpx;
  border-radius: 6rpx;
}

