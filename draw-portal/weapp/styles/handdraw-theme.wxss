  background: #f5ead8 !important;
  border-color: rgba(38, 56, 74, 0.32) !important;
}

.text-input {
  color: #26384a !important;
  background: #fffdf7 !important;
  border-color: rgba(38, 56, 74, 0.34) !important;
}

.tool-traces,
.draw-state,
.reply-pending,
.voice-status {
  color: #756d61 !important;
}

.eye,
.thinking-dots view {
  background: #b84c3f !important;
}

.smile {
  border-color: #b84c3f !important;
}

.hold-btn.cancel {
  color: #fffaf0 !important;
  background: #a43e36 !important;
}

/* 许可要求在产品中可见地保留作者与仓库地址。 */
.handraw-credit {
  background: #fffaf0 !important;
  border: 2rpx solid rgba(38, 56, 74, 0.34) !important;
  border-radius: 18rpx 24rpx 20rpx 26rpx !important;
  box-shadow: 6rpx 8rpx 0 rgba(38, 56, 74, 0.07) !important;
}

.credit-link {
  color: #b84c3f !important;
}

/*
 * FH-031 奶油卖萌层：让“小派”成为贯穿页面的记忆点。
 * 这里集中覆盖旧纸本候选，避免触碰任何页面状态机或设备动作逻辑。
 */
.hero,
.atelier-head {
  min-height: 176rpx;
  padding-right: 150rpx !important;
  border-color: rgba(77, 58, 70, 0.26) !important;
  background: linear-gradient(145deg, #fffdf8 0%, #fff0f4 56%, #eef9f4 100%) !important;
  box-shadow: 8rpx 10rpx 0 rgba(216, 95, 123, 0.10) !important;
}

.hero::after,
.atelier-head::after {
  right: -12rpx;
  bottom: -24rpx;
  width: 190rpx;
  height: 100rpx;
  border-color: rgba(243, 163, 181, 0.34);
}

.atelier-kicker,
.hero-brand,
.eyebrow,
.weui-cells__title {
  color: #d85f7b !important;
}

.atelier-title,
.hero-title,
.slim-title,
.gallery-title,
.heading,
.empty-title,
.section-title,
.offline-title,
.work-title,
.settings-heading,
.companion-name,
.welcome-title {
  color: #4d3a46 !important;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 800 !important;
}

.atelier-copy,
.hero-sub,
.gallery-sub,
.empty-sub,
.section-desc,
.work-sub,
.companion-status,
.welcome-copy,
.welcome-kicker {
  color: #8f7a84 !important;
}

.atelier-line {
  border-color: #e2b75d;
}

.pai-mascot {
  position: absolute;
  right: 30rpx;
  top: 28rpx;
  width: 104rpx;
  height: 104rpx;
  transform: rotate(4deg);
  animation: pai-float 3.2s ease-in-out infinite;
}

.pai-ear {
  position: absolute;
  top: 2rpx;
  width: 34rpx;
  height: 38rpx;
  border: 3rpx solid #6b4e5e;
  border-bottom: 0;
  background: #f3a3b5;
  transform: rotate(-22deg);
}

.pai-ear-left {
  left: 12rpx;
  border-radius: 28rpx 8rpx 16rpx 8rpx;
}

.pai-ear-right {
  right: 12rpx;
  border-radius: 8rpx 28rpx 8rpx 16rpx;
  transform: rotate(22deg);
}

.pai-face {
  position: absolute;
  left: 8rpx;
  top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  width: 88rpx;
  height: 76rpx;
  border: 3rpx solid #6b4e5e;
  border-radius: 42rpx 46rpx 38rpx 44rpx;
  background: #fffdf8;
  box-shadow: 4rpx 6rpx 0 rgba(216, 95, 123, 0.16);
}

.pai-eye {
  width: 12rpx;
  height: 21rpx;
  margin-top: -9rpx;
  border-radius: 50%;
  background: #6b4e5e;
  animation: pai-blink 5.6s infinite;
}

.pai-blush {
  position: absolute;
  top: 46rpx;
  width: 17rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(243, 163, 181, 0.72);
}

.pai-blush-left { left: 12rpx; }
.pai-blush-right { right: 12rpx; }

.pai-mouth {
  position: absolute;
  left: 37rpx;
  top: 48rpx;
  width: 14rpx;
  height: 7rpx;
  border: 3rpx solid #d85f7b;
  border-top: 0;
  border-radius: 0 0 14rpx 14rpx;
}

.pai-star {
  position: absolute;
  right: -8rpx;
  top: 5rpx;
  color: #e2b75d;
  font-size: 26rpx;
  font-weight: 800;
  transform: rotate(12deg);
}

.pai-mascot-thinking .pai-mouth {
  width: 9rpx;
  height: 9rpx;
  border: 3rpx solid #d85f7b;
  border-radius: 50%;
}

.pai-mascot-happy .pai-eye {
  height: 9rpx;
  border-radius: 50% 50% 0 0;
}

.pai-mascot-wink .pai-eye:first-child {
  height: 4rpx;
  border-radius: 6rpx;
}

