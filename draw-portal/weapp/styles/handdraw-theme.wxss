/*
 * 全站手绘主题覆盖层：handraw-style FH-031 小红书奶油手绘。
 * 上游：https://github.com/yang0/handraw-style（作者 yang0）。
 * 纸张与墨线保持克制，朱砂只用于关键动作；不使用会干扰可读性的纹理图片。
 */

page,
.page,
.market-page,
.detail-page,
.paper-settings,
.studio {
  background: #fff7ed !important;
  color: #4d3a46 !important;
}

.page {
  position: relative;
}

button,
input,
textarea,
picker,
slider {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button::after {
  border: none !important;
}

.hero,
.atelier-head {
  position: relative;
  overflow: hidden;
  margin: 26rpx 26rpx 18rpx !important;
  padding: 34rpx 32rpx 32rpx !important;
  border: 2rpx solid rgba(38, 56, 74, 0.56) !important;
  border-radius: 20rpx 30rpx 22rpx 26rpx !important;
  background: #fffaf0 !important;
  box-shadow: 8rpx 10rpx 0 rgba(38, 56, 74, 0.08) !important;
}

.hero::after,
.atelier-head::after {
  content: "";
  position: absolute;
  right: -26rpx;
  bottom: -32rpx;
  width: 168rpx;
  height: 92rpx;
  border: 4rpx solid rgba(184, 76, 63, 0.24);
  border-radius: 50%;
  transform: rotate(-12deg);
}

.atelier-kicker,
.hero-brand,
.eyebrow,
.weui-cells__title {
  color: #a94439 !important;
  font-size: 22rpx !important;
  font-weight: 700 !important;
  letter-spacing: 3rpx !important;
}

.atelier-title,
.hero-title,
.slim-title,
.gallery-title,
.heading,
.empty-title,
.section-title,
.offline-title,
.work-title,
.settings-heading {
  color: #26384a !important;
  font-family: "STKaiti", "KaiTi", "PingFang SC", serif;
}

.atelier-title {
  display: block;
  margin-top: 10rpx;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: 2rpx;
}

.atelier-copy,
.hero-sub,
.gallery-sub,
.empty-sub,
.section-desc,
.work-sub {
  color: #81786b !important;
}

.atelier-mark {
  position: absolute;
  right: 42rpx;
  top: 34rpx;
  width: 72rpx;
  height: 72rpx;
  border: 4rpx solid #b84c3f;
  border-radius: 12rpx 18rpx 10rpx 16rpx;
  color: #b84c3f;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
  transform: rotate(6deg);
  opacity: 0.88;
}

.atelier-line {
  width: 132rpx;
  height: 10rpx;
  margin-top: 22rpx;
  border-top: 4rpx solid #bf9148;
  border-radius: 50%;
  transform: rotate(-2deg);
}

.accent,
.title-accent,
.heading text {
  color: #b84c3f !important;
}

.weui-cells,
.input-panel,
.preview-card,
.status-card,
.jog-block,
.speed-block,
.offline-card,
.settings-panel,
.paper-scene,
.send-panel,
.credit-panel,
.section,
.sk-panel,
.work-cell,
.gallery-card,
.paper-frame,
.draft-notice,
.history-notice,
.generation-note,
.bind-banner {
  background: #fffaf0 !important;
  border: 2rpx solid rgba(38, 56, 74, 0.34) !important;
  box-shadow: 6rpx 8rpx 0 rgba(38, 56, 74, 0.07) !important;
}

.weui-cells,
.input-panel,
.status-card,
.jog-block,
.speed-block,
.offline-card,
.settings-panel,
.paper-scene,
.send-panel,
.credit-panel,
.section,
.sk-panel {
  border-radius: 18rpx 24rpx 20rpx 26rpx !important;
}

.weui-cell + .weui-cell::before,
.row-actions,
.divider-line {
  background: rgba(38, 56, 74, 0.14) !important;
  border-color: rgba(38, 56, 74, 0.14) !important;
}

.weui-cell__bd,
.nick-input,
.name,
.status-main,
.status-state,
.jog-label,
.speed-label,
.speed-axis-label,
.paper-summary-title,
.message-author,
.card-caption,
.draw-desc,
.picked,
.setting-row,
.device-row,
.credit-text,
.notice-title {
  color: #26384a !important;
}

.muted,
.weui-cell__ft,
.weui-cells__tips,
.input-caption,
.example-row,
.result-count,
.preview-meta,
.timeline-hint,
.timeline-lab,
.eta-row,
.ota-line,
.page-bar-meta,
.speed-hint,
.offline-sub,
.phone-text,
.support-email,
.preview-tip,
.action-hint,
.field-help,
.mapping,
.page-foot,
.voice-hint,
.ai-note {
  color: #81786b !important;
}

.weui-btn,
.empty-action,
.send-btn,
.send-button,
.go-btn,
.confirm-btn,
.text-send,
.btn-confirm,
.draw-btn,
.connection-refresh,
.save-button {
  border-radius: 14rpx 18rpx 13rpx 17rpx !important;
  box-shadow: 4rpx 5rpx 0 rgba(38, 56, 74, 0.13);
}

.weui-btn_primary,
.empty-action,
.send-btn,
.send-button,
.go-btn,
.confirm-btn,
.text-send,
.btn-confirm,
.draw-btn,
.save-button {
  color: #fffaf0 !important;
  background: #b84c3f !important;
  border: 2rpx solid #7f342e !important;
}

.weui-btn_primary:not([disabled]):active,
.empty-action:active,
.send-button:active,
.go-btn:active {
  background: #9f3f36 !important;
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 3rpx 0 rgba(38, 56, 74, 0.12);
}

.weui-btn_default,
.favorite-button,
.retry-button,
.btn-cancel,
.job-btn,
.pen-btn,
.dpad-btn,
.step-pill,
.preset,
.chip,
.suggestion,
.input-toggle,
.mic-enable,
.search-clear,
.search-sort,
.redraw-btn,
.del-btn,
.speed-retry,
.connection-refresh {
  color: #26384a !important;
  background: #f5ead8 !important;
  border: 2rpx solid rgba(38, 56, 74, 0.38) !important;
}

.weui-btn_warn,
.danger,
.logout-btn {
  color: #a43e36 !important;
  background: rgba(184, 76, 63, 0.06) !important;
  border-color: rgba(164, 62, 54, 0.42) !important;
}

.weui-btn[disabled],
button[disabled] {
  opacity: 0.44 !important;
  box-shadow: none !important;
}

.field,
.work-search,
.text-input,
.cell-input,
.compact-input,
.dimension-inputs input,
.font-picker-val,
.group-picker,
.weui-textarea,
textarea,
input {
  color: #26384a !important;
  background: #fffdf7 !important;
  border-color: rgba(38, 56, 74, 0.28) !important;
}

.ph {
  color: #aaa091 !important;
}

.mode-segment,
.version-switch,
.chips,
.presets,
.voice-grid {
  background: transparent !important;
}

.mode-segment {
  margin: 22rpx 26rpx 10rpx !important;
  padding: 8rpx !important;
  border: 2rpx solid rgba(38, 56, 74, 0.34) !important;
  border-radius: 18rpx !important;
  background: #eaddca !important;
}

.mode-tab {
  color: #756d61 !important;
  border-radius: 12rpx 16rpx 11rpx 15rpx !important;
}

.mode-tab.active,
.chip-on,
.preset.selected,
.model-on,
.version-switch .selected {
  color: #fffaf0 !important;
  background: #26384a !important;
  border-color: #26384a !important;
  box-shadow: 3rpx 4rpx 0 rgba(184, 76, 63, 0.2) !important;
}

.paper-summary,
.control-paper-link {
  background: #efe3d2 !important;
  border: 2rpx dashed rgba(38, 56, 74, 0.42) !important;
  border-radius: 15rpx 20rpx 16rpx 22rpx !important;
}

.paper-summary-sheet {
  border-color: #b84c3f !important;
  background: #fffaf0;
  box-shadow: 3rpx 3rpx 0 rgba(38, 56, 74, 0.12);
}

.paper-summary-sheet::after {
  border-color: rgba(38, 56, 74, 0.44) !important;
}

.paper-summary-detail,
.paper-summary-hint,
.paper-summary-arrow,
.control-paper-link {
  color: #756d61 !important;
}

.action-grid {
  gap: 18rpx !important;
}

.action-tile {
  position: relative;
  overflow: hidden;
  background: #fffaf0 !important;
  border: 2rpx solid rgba(38, 56, 74, 0.4) !important;
  border-radius: 18rpx 24rpx 17rpx 22rpx !important;
  box-shadow: 5rpx 7rpx 0 rgba(38, 56, 74, 0.08) !important;
}

.action-tile::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 12rpx;
  width: 24rpx;
  height: 8rpx;
  border-top: 3rpx solid rgba(191, 145, 72, 0.7);
  transform: rotate(-8deg);
}

.tile-label,
.bind-title,
.result-title,
.refine-waiting-title {
  color: #26384a !important;
}

.tile-icon,
.empty-glyph,
.intro-art,
.companion-face {
  border-color: rgba(38, 56, 74, 0.5) !important;
  box-shadow: none !important;
}

.bind-banner.market-banner {
  background: #e9dcc6 !important;
}

.bind-go,
.slim-quota,
.result-badge,
.phone-link,
.speed-val,
.thumb-retry,
.search-clear,
.search-sort,
.advanced-arrow,
.settings-entry,
.suggestion-arrow,
.work-title + .card-arrow {
  color: #b84c3f !important;
}

.preview,
.preview-img,
.thumb,
.card-paper,
.work-preview,
.sheet {
  background: #fffef9 !important;
  border: 2rpx solid rgba(38, 56, 74, 0.32) !important;
  border-radius: 12rpx 18rpx 14rpx 20rpx !important;
  box-shadow: 4rpx 6rpx 0 rgba(38, 56, 74, 0.08) !important;
}

.work-cell,
.gallery-card {
  border-radius: 16rpx 23rpx 18rpx 25rpx !important;
}

.gallery-card:nth-child(2n),
.work-cell:nth-child(2n) {
  transform: rotate(0.35deg);
}

.gallery-card:nth-child(3n),
.work-cell:nth-child(3n) {
  transform: rotate(-0.3deg);
}

.status-dot,
.device-dot,
.timeline-dot {
  background: #aaa091 !important;
  box-shadow: 0 0 0 5rpx rgba(129, 120, 107, 0.12) !important;
}

.status-dot.ok,
.device-dot.connected,
.timeline-step.done .timeline-dot {
  background: #65785e !important;
  box-shadow: 0 0 0 5rpx rgba(101, 120, 94, 0.16) !important;
}

.status-dot.bad {
  background: #b84c3f !important;
}

.timeline-step.active .timeline-dot,
.page-bar-fill,
.progress-fill {
  background: #b84c3f !important;
}

.page-bar-track,
.progress-bar {
  background: #dfd2bf !important;
  border: 1rpx solid rgba(38, 56, 74, 0.2);
}

.dpad-btn.home {
  color: #fffaf0 !important;
  background: #26384a !important;
}

.job-btn.danger {
  color: #fffaf0 !important;
  background: #a43e36 !important;
}

.chat-header,
.composer {
  background: rgba(255, 250, 240, 0.96) !important;
  border-color: rgba(38, 56, 74, 0.24) !important;
  box-shadow: 0 8rpx 24rpx rgba(74, 54, 38, 0.08) !important;
}

.companion-face {
  background: #e8d6b7 !important;
}

.companion-name,
.welcome-title {
  color: #26384a !important;
  font-family: "STKaiti", "KaiTi", serif;
}

.companion-status,
.welcome-copy,
.welcome-kicker {
  color: #81786b !important;
}

.bubble {
  color: #26384a !important;
  background: #fffaf0 !important;
  border: 2rpx solid rgba(38, 56, 74, 0.28) !important;
  border-radius: 18rpx 22rpx 18rpx 8rpx !important;
  box-shadow: 4rpx 5rpx 0 rgba(38, 56, 74, 0.06) !important;
}

.msg-row.user .bubble {
  color: #fffaf0 !important;
  background: #26384a !important;
  border-radius: 22rpx 18rpx 8rpx 18rpx !important;
}

.hold-btn {
  color: #fffaf0 !important;
  background: #b84c3f !important;
  border-color: #7f342e !important;
}

.hold-btn.active {
  background: #26384a !important;
}

.history-notice,
.generation-note,
.draft-notice,
.device-note,
.error-bar,
.load-error,
.control-error,
.speed-error,
.fit-error,
.share-feedback,
.preview-error,
.draw-state.warn {
