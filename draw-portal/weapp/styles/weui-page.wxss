/* 全站布局层：只放间距、排版和 flex；useExtendedLib 下不 @import weui.wxss。
 * 颜色、底色、边框、阴影和 hero 外框一律由 handdraw-theme.wxss 决定。本文件由页面 @import，
 * 在主题之后加载，同优先级时会盖过主题；10-31 前这里留着深空青光配色，首页和个人页因此还是暗色。 */

.page {
  min-height: 100vh;
  padding-bottom: 56rpx;
  box-sizing: border-box;
}

.hero-brand {
  margin-bottom: 12rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
  margin-bottom: 12rpx;
}

.hero-sub {
  font-size: 26rpx;
  line-height: 1.5;
}

.weui-cells__title {
  margin: 0;
  padding: 36rpx 32rpx 16rpx;
}

.weui-cells {
  margin: 0 24rpx;
  position: relative;
  overflow: hidden;
}

.weui-cells::before,
.weui-cells::after {
  display: none;
}

.weui-cell {
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.weui-cell + .weui-cell::before {
  content: " ";
  position: absolute;
  left: 32rpx;
  right: 0;
  top: 0;
  height: 1px;
  transform: scaleY(0.5);
}

.weui-cell__hd {
  margin-right: 8rpx;
}

.weui-cell__bd {
  flex: 1;
  font-size: 32rpx;
}

.weui-cell__ft {
  font-size: 26rpx;
  text-align: right;
  padding-left: 16rpx;
}

.weui-cells__tips {
  margin: 12rpx 36rpx 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.weui-btn-area {
  margin: 36rpx 28rpx 12rpx;
}

.weui-btn-area.tight {
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

.weui-btn {
  display: block;
  width: 100%;
  padding: 8rpx 48rpx;
  box-sizing: border-box;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  line-height: 2.4;
  border-radius: 999rpx;
  overflow: hidden;
}

.weui-btn::after {
  border: none;
}

.field {
  border-radius: 16rpx;
  padding: 22rpx;
  font-size: 30rpx;
  margin: 0 32rpx 16rpx;
}

.divider {
  display: flex;
  align-items: center;
  margin: 28rpx 32rpx;
}

.divider-line {
  flex: 1;
  height: 1px;
}

.divider-text {
  padding: 0 20rpx;
  font-size: 24rpx;
}

.page-foot {
  text-align: center;
  padding: 48rpx 0 24rpx;
  font-size: 22rpx;
}

.muted {
  font-size: 24rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.section-tip {
  font-size: 24rpx;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}
