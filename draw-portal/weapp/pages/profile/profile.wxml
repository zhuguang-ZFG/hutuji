<view class="page">
  <view class="hero">
    <view class="hero-brand">动力巢科技 · 小派</view>
    <view class="hero-title">我的<text class="accent">账号</text></view>
    <view class="hero-sub">头像与手机号用于绑定设备、同步你的作品</view>
  </view>

  <block wx:if="{{loggedOut}}">
    <view class="weui-cells__title">已退出登录</view>
    <view class="weui-cells__tips">本地会话已清除。你的作品、收藏与设备绑定都还在云端，重新登录即可恢复。</view>
    <view class="weui-btn-area">
      <button class="weui-btn weui-btn_primary" bindtap="onLoginAgain" loading="{{loggingIn}}" disabled="{{loggingIn}}">微信一键登录</button>
    </view>
  </block>

  <view wx:if="{{loadError}}" class="weui-cells__tips">{{loadError}}</view>
  <button wx:if="{{loadError && !loggedOut}}" size="mini" bindtap="refresh">重新读取</button>
  <block wx:if="{{!loggedOut && needPhone}}">
    <view class="weui-cells__title">使用前请授权手机号</view>
    <view class="weui-cells__tips">绑机、传图、控制丹青都需要手机号。授权后即可继续。</view>
    <view class="weui-btn-area">
      <button
        class="weui-btn weui-btn_primary"
        open-type="getPhoneNumber"
        bind:getphonenumber="onGetPhone"
      >
        授权手机号
      </button>
    </view>
  </block>

  <block wx:if="{{!loggedOut && me}}">
  <view class="weui-cells__title">账号</view>
  <view class="weui-cells">
    <view class="weui-cell profile-cell">
      <view class="weui-cell__hd">
        <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          <image wx:if="{{avatarSrc}}" class="avatar" src="{{avatarSrc}}" mode="aspectFill" />
          <view wx:else class="avatar placeholder">+</view>
        </button>
      </view>
      <view class="weui-cell__bd">
        <input
          class="nick-input"
          type="nickname"
          placeholder="微信昵称"
          value="{{nicknameDraft}}"
          bindinput="onNickInput"
          bindblur="onSaveNick"
        />
        <button
          wx:if="{{needPhone}}"
          class="phone-link"
          open-type="getPhoneNumber"
          bind:getphonenumber="onGetPhone"
        >
          绑定手机号
        </button>
        <view wx:else class="phone-text">{{me.phone}}</view>
      </view>
    </view>
  </view>
    <view class="weui-btn-area tight">
      <button class="weui-btn logout-btn" bindtap="onLogout">退出登录</button>
    </view>
  </block>


  <block wx:if="{{!loggedOut && me && !needPhone}}">
    <view class="weui-cells__title">设备</view>
    <view class="weui-cells">
      <block wx:for="{{me.devices}}" wx:key="device_mac">
        <view class="weui-cell link-cell" data-mac="{{item.device_mac}}" bindtap="onSelectDevice">
          <view class="weui-cell__bd">设备 {{item.device_mac}}</view>
          <view class="weui-cell__ft">{{item.active ? '当前使用' : '切换'}}</view>
        </view>
      </block>
      <view class="weui-cell" wx:if="{{me && me.binding && me.binding.bound}}">
        <view class="weui-cell__bd">已绑定</view>
        <view class="weui-cell__ft">{{me.binding.device_mac}}</view>
      </view>
      <view class="weui-cell" wx:else>
        <view class="weui-cell__bd">未绑定</view>
        <view class="weui-cell__ft">绑定后才能发送任务</view>
      </view>
    </view>
    <view class="weui-btn-area tight">
      <button class="weui-btn weui-btn_primary" bindtap="onGoBind">
        {{me && me.binding && me.binding.bound ? "换绑 / 查看" : "去绑定"}}
      </button>
    </view>

    <view class="weui-cells__title">网络</view>
    <view class="weui-cells__tips">新丹青或换了 WiFi 时，一键把设备连上家里网络</view>
    <view class="weui-btn-area tight">
      <button class="weui-btn weui-btn_default" bindtap="onGoWifi">一键配网</button>
    </view>

    <view class="weui-cells__title">纸张与版式</view>
    <navigator url="/pages/paper/paper" class="weui-cells"><view class="weui-cell link-cell"><view class="weui-cell__bd">纸张、方向与留边</view><view class="weui-cell__ft">设置 ›</view></view></navigator>

    <view class="weui-cells__title">固件</view>
    <view class="weui-cells__tips">检查并升级小派固件；丹青远程升级后续支持</view>
    <view class="weui-btn-area tight">
      <button class="weui-btn weui-btn_default" bindtap="onGoFirmware">固件升级</button>
    </view>

    <view class="weui-cells__title">聊小派</view>
    <view class="weui-cells__tips">按住说话或直接打字：聊天、画画、写字、查状态都行</view>
    <view class="weui-btn-area tight">
      <button class="weui-btn weui-btn_default" bindtap="onGoChat">去和小派聊</button>
    </view>

  </block>

  <view class="weui-cells__title">隐私与帮助</view>
  <view class="weui-btn-area tight">
    <button class="weui-btn weui-btn_default" bindtap="onPrivacy">隐私保护指引</button>
    <button class="weui-btn weui-btn_default" open-type="contact" binderror="onContactError">微信客服</button>
    <view class="support-email"><text selectable="{{true}}">客服邮箱：{{supportEmail}}</text></view>
    <button class="weui-btn weui-btn_default" bindtap="onCopySupportEmail">复制客服邮箱</button>
  </view>
  <view class="page-foot muted">动力巢科技 · {{footVersion}}</view>
</view>
