@import "../../styles/weui-page.wxss";

.profile-cell {
  align-items: center;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: 1;
  width: 120rpx;
  height: 120rpx;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 3rpx solid rgba(0, 209, 229, 0.55);
  box-shadow: 0 0 24rpx rgba(0, 209, 229, 0.25);
}

.avatar.placeholder {
  background: #1a1b28;
  color: #00d1e5;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.nick-input {
  font-size: 34rpx;
  color: #f2f4f8;
  padding: 4rpx 0 12rpx;
}

.phone-link {
  display: inline-block;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #00d1e5;
  font-size: 26rpx;
  line-height: 1.4;
  text-align: left;
}

.phone-link::after {
  border: none;
}

.phone-text {
  font-size: 26rpx;
  color: #9aa3b5;
}
