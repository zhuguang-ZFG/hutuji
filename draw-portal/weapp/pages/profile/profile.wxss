@import "../../styles/weui-page.wxss";

.profile-cell {
  align-items: center;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: 1;
  width: 120rpx;
  height: 120rpx;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 3rpx solid rgba(216, 95, 123, 0.55);
  box-shadow: 0 0 24rpx rgba(216, 95, 123, 0.25);
}

.avatar.placeholder {
  background: #fffdf8;
  color: #b03f5a;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.nick-input {
  font-size: 34rpx;
  color: #4d3a46;
  padding: 4rpx 0 12rpx;
}

.phone-link {
  display: inline-block;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #b03f5a;
  font-size: 26rpx;
  line-height: 1.4;
  text-align: left;
}

.phone-link::after {
  border: none;
}

.phone-text {
  font-size: 26rpx;
  color: #735f69;
}

.support-email {
  margin: 24rpx 0 16rpx;
  font-size: 26rpx;
  text-align: center;
  word-break: break-all;
}

/* 退出登录：弱化警示文本按钮，避免与主按钮同级重量（量产惯例：退出入口要可见但不抢眼） */
.logout-btn {
  background: transparent;
  color: #a3354d;
  font-size: 28rpx;
  border: 2rpx solid rgba(200, 86, 104, 0.42);
  border-radius: 12rpx;
}

.logout-btn::after {
  border: none;
}

.handraw-credit {
  margin: 0 24rpx 28rpx;
  padding: 26rpx 28rpx;
}

.credit-text {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.6;
}

.credit-change,
.credit-link {
  display: block;
  margin-top: 8rpx;
  color: #735f69;
  font-size: 23rpx;
  line-height: 1.55;
  word-break: break-all;
}

.credit-copy {
  margin: 20rpx 0 0;
}
