@import "../../styles/weui-page.wxss";

.profile-cell {
  align-items: center;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: 1;
  width: 120rpx;
  height: 120rpx;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 3rpx solid rgba(0, 209, 229, 0.55);
  box-shadow: 0 0 24rpx rgba(0, 209, 229, 0.25);
}

.avatar.placeholder {
  background: #1a1b28;
  color: #00d1e5;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.nick-input {
  font-size: 34rpx;
  color: #f2f4f8;
  padding: 4rpx 0 12rpx;
}

.phone-link {
  display: inline-block;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #00d1e5;
  font-size: 26rpx;
  line-height: 1.4;
  text-align: left;
}

.phone-link::after {
  border: none;
}

.phone-text {
  font-size: 26rpx;
  color: #9aa3b5;
}

.support-email {
  margin: 24rpx 0 16rpx;
  color: #b8c1d1;
  font-size: 26rpx;
  text-align: center;
  word-break: break-all;
}

/* 退出登录：弱化警示文本按钮，避免与主按钮同级重量（量产惯例：退出入口要可见但不抢眼） */
.logout-btn {
  background: transparent;
  color: #e57373;
  font-size: 28rpx;
  border: 2rpx solid rgba(229, 115, 115, 0.45);
  border-radius: 12rpx;
}

.logout-btn::after {
  border: none;
}
