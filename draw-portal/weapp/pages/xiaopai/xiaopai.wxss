.page {
  padding: 24rpx 24rpx 80rpx;
  background: #f7f7f9;
  min-height: 100vh;
  box-sizing: border-box;
}
.loading,
.error-bar {
  text-align: center;
  color: #888;
  padding: 60rpx 0;
}
.error-bar {
  color: #c0392b;
}
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}
.section-desc {
  font-size: 24rpx;
  color: #999;
  margin: 8rpx 0 16rpx;
}
.group-picker {
  font-size: 26rpx;
  color: #4a6cf7;
  padding: 8rpx 0 16rpx;
}
.voice-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.chip {
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
  background: #f2f3f7;
  color: #333;
  font-size: 26rpx;
  border: 2rpx solid transparent;
}
.chip-on {
  background: #eef1ff;
  color: #4a6cf7;
  border-color: #4a6cf7;
}
.picked {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #666;
}
.model-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.model-item {
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.model-on {
  border-color: #4a6cf7;
  background: #eef1ff;
}
.model-name {
  font-size: 28rpx;
  color: #222;
}
.model-desc {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}
.bound-ok {
  color: #1a9c5c;
  font-size: 26rpx;
}
.bind-help {
  font-size: 24rpx;
  color: #4a6cf7;
  margin: 12rpx 0;
}
.bind-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}
.code-input {
  flex: 1;
  border: 2rpx solid #e3e3e8;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
}
.bind-btn {
  background: #4a6cf7;
  color: #fff;
}
.save-btn {
  margin-top: 40rpx;
  background: #e5e6eb;
  color: #999;
}
.save-on {
  background: #4a6cf7;
  color: #fff;
}
