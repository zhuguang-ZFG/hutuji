.page {
  padding: 24rpx 24rpx 80rpx;
  background: #f7f7f9;
  min-height: 100vh;
  box-sizing: border-box;
}
.loading,
.error-bar {
  text-align: center;
  color: #735f69;
  padding: 60rpx 0;
}
.error-bar {
  color: #ac384a;
}
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4d3a46;
}
.section-desc {
  font-size: 24rpx;
  color: #735f69;
  margin: 8rpx 0 16rpx;
}
.group-picker {
  font-size: 26rpx;
  color: #b03f5a;
  padding: 8rpx 0 16rpx;
}
.voice-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.chip {
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
  color: #4d3a46;
  font-size: 26rpx;
  border: 2rpx solid transparent;
}
.chip-on {
  color: #b03f5a;
  border-color: #d85f7b;
}
.picked {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #735f69;
}
.model-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.model-item {
  border: 2rpx solid rgba(77, 58, 70, 0.16);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.model-on {
  border-color: #d85f7b;
}
.model-name {
  font-size: 28rpx;
  color: #4d3a46;
}
.model-desc {
  font-size: 22rpx;
  color: #735f69;
  margin-top: 4rpx;
}
.bound-ok {
  color: #3f6a5e;
  font-size: 26rpx;
}
.bind-help {
  font-size: 24rpx;
  color: #b03f5a;
  margin: 12rpx 0;
}
.bind-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}
.code-input {
  flex: 1;
  border: 2rpx solid #e3e3e8;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
}
.bind-btn {
  background: #f3a3b5;
  color: #4d3a46;
}
.save-btn {
  margin-top: 40rpx;
  background: #f3dfc8;
  color: #735f69;
}
.save-on {
  background: #f3a3b5;
  color: #4d3a46;
}
