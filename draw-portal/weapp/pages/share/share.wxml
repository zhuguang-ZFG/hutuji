<view class="page">
  <block wx:if="{{loading}}">
    <view class="sk-panel">
      <view class="sk-box sk-pulse"></view>
      <view class="sk-line w50 sk-pulse"></view>
    </view>
  </block>

  <block wx:elif="{{failed}}">
    <view class="sk-panel">
      <view class="failed-title">{{failureTitle}}</view>
      <view class="failed-sub">{{failureDetail}}</view>
      <button wx:if="{{retryable}}" class="retry-btn" bindtap="onRetry">重新读取</button>
      <button class="go-btn" bindtap="onGoDraw">我也要画</button>
    </view>
  </block>

  <block wx:else>
    <view class="card">
      <view class="work-title">{{title}}</view>
      <view class="work-date" wx:if="{{createdAt}}">{{createdAt}}</view>
      <image
        wx:if="{{previewUrl}}"
        class="preview"
        src="{{previewUrl}}"
        mode="widthFix"
        binderror="onPreviewError"
      />
      <view wx:elif="{{previewError}}" class="preview preview-error">
        <text>{{previewError}}</text>
        <button class="retry-btn" size="mini" bindtap="onRetryPreview">重新加载图片</button>
      </view>
      <view wx:else class="preview preview-loading sk-pulse"><text class="loading-label">正在加载图片…</text></view>
    </view>
    <button class="go-btn" bindtap="onGoDraw">我也要画</button>
    <view class="tips">打开「动力巢科技」，一句话就能让丹青画画</view>
  </block>
</view>
