.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
  background: #fff7ed;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sk-panel {
  width: 100%;
  padding-top: 20vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sk-box {
  width: 560rpx;
  height: 560rpx;
  border-radius: 24rpx;
  background: #fdebdc;
}

.sk-pulse {
  animation: pulse 1.4s ease-in-out infinite;
}

@keyframes pulse {
  0%,
  100% {
    opacity: 0.55;
  }
  50% {
    opacity: 1;
  }
}

.sk-line {
  margin-top: 24rpx;
  height: 24rpx;
  border-radius: 8rpx;
}

.w50 {
  width: 300rpx;
}

.failed-title {
  margin-top: 6vh;
  font-size: 34rpx;
  font-weight: 600;
}

.failed-sub {
  margin-top: 16rpx;
  color: #735f69;
  font-size: 26rpx;
}

.card {
  width: 100%;
  background: #fffdf8;
  border-radius: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.work-title {
  font-size: 32rpx;
  font-weight: 600;
  word-break: break-all;
}

.work-date {
  margin-top: 8rpx;
  color: #735f69;
  font-size: 24rpx;
}

.preview {
  margin-top: 24rpx;
  width: 100%;
  border-radius: 16rpx;
  background: #fff7ed;
}

.preview-loading {
  height: 560rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-label, .preview-error {
  color: #735f69;
  font-size: 26rpx;
}

.preview-error {
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.retry-btn {
  margin: 24rpx auto 0;
  min-width: 0 !important;
  width: auto !important;
  padding: 0 28rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
}

.go-btn {
  margin-top: 48rpx;
  width: 80%;
  border-radius: 48rpx;
  font-weight: 600;
}

.tips {
  margin-top: 20rpx;
  color: #735f69;
  font-size: 24rpx;
}
