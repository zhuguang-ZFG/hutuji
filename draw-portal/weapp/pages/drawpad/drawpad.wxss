.wrap {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 12rpx 0;
  background: #0b0c13;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 4rpx 16rpx;
}

.tool {
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  background: #171a26;
  color: #9aa3b5;
  font-size: 26rpx;
  border: 1rpx solid #262b3a;
}

.tool.on {
  color: #00d1e5;
  border-color: rgba(0, 209, 229, 0.6);
  background: rgba(0, 209, 229, 0.08);
}

.spacer {
  flex: 1;
}

.board {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  min-height: 0;
}

.pad {
  background: #f7f5ef;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.45);
}

.hint {
  position: absolute;
  top: 46%;
  width: 100%;
  text-align: center;
  color: #b9b2a4;
  font-size: 26rpx;
  pointer-events: none;
}

.foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 4rpx calc(14rpx + env(safe-area-inset-bottom));
}

.count {
  color: #6b7385;
  font-size: 24rpx;
}

.submit-btn {
  margin: 0;
  padding: 0 44rpx;
  line-height: 84rpx;
  background: #00d1e5;
  color: #04252b;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  opacity: 0.45;
  color: #04252b;
  background: #00d1e5;
}
