@import "../../styles/weui-page.wxss";

.notes-cell {
  align-items: flex-start;
}

.notes-text {
  color: #9aa3b5;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: right;
  max-width: 420rpx;
}

.highlight .weui-cell__ft {
  color: #00d1e5;
  font-weight: 600;
}

.badge {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #0b0c13;
  background: #00d1e5;
  vertical-align: middle;
}

.progress-wrap {
  margin: 24rpx 24rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: #14151f;
  border: 1rpx solid rgba(0, 209, 229, 0.25);
}

.progress-label {
  font-size: 26rpx;
  color: #f2f4f8;
  margin-bottom: 16rpx;
}

.progress-bar {
  height: 12rpx;
  border-radius: 8rpx;
  background: #1a1b28;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #00d1e5, #58a6ff);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.progress-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9aa3b5;
}

.status-tip {
  margin: 16rpx 32rpx 0;
  font-size: 26rpx;
  color: #9aa3b5;
  line-height: 1.5;
}

.status-tip.warn {
  color: #fa5151;
}

.status-tip.ok {
  color: #00d1e5;
}
