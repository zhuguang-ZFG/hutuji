@import "../../styles/weui-page.wxss";

.notes-cell {
  align-items: flex-start;
}

.notes-text {
  color: #735f69;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: right;
  max-width: 420rpx;
}

.highlight .weui-cell__ft {
  color: #b03f5a;
  font-weight: 600;
}

.badge {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #4d3a46;
  background: #f3a3b5;
  vertical-align: middle;
}

.progress-wrap {
  margin: 24rpx 24rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: #fffdf8;
  border: 1rpx solid rgba(216, 95, 123, 0.25);
}

.progress-label {
  font-size: 26rpx;
  color: #4d3a46;
  margin-bottom: 16rpx;
}

.progress-bar {
  height: 12rpx;
  border-radius: 8rpx;
  background: #fffdf8;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #f3a3b5, #f5d77f);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.progress-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #735f69;
}

.status-tip {
  margin: 16rpx 32rpx 0;
  font-size: 26rpx;
  color: #735f69;
  line-height: 1.5;
}

.status-tip.warn {
  color: #ac384a;
}

.status-tip.ok {
  color: #b03f5a;
}
