<view class="page">
  <view class="hero">
    <view class="hero-brand">动力巢科技</view>
    <view class="hero-title">固件<text class="accent">升级</text></view>
    <view class="hero-sub">仅升级小派；升级中请勿断电、勿出图</view>
  </view>

  <view class="weui-cells__title">小派</view>
  <view class="weui-cells">
    <view class="weui-cell">
      <view class="weui-cell__bd">当前版本</view>
      <view class="weui-cell__ft">{{current || "—"}}</view>
    </view>
    <view class="weui-cell {{updateAvailable ? 'highlight' : ''}}">
      <view class="weui-cell__bd">
        最新版本
        <text wx:if="{{updateAvailable}}" class="badge">有更新</text>
      </view>
      <view class="weui-cell__ft">{{latest || "—"}}</view>
    </view>
    <view class="weui-cell notes-cell" wx:if="{{notes}}">
      <view class="weui-cell__bd">更新说明</view>
      <view class="weui-cell__ft notes-text">{{notes}}</view>
    </view>
  </view>

  <view class="progress-wrap" wx:if="{{upgrading || progress > 0}}">
    <view class="progress-label">{{progressLabel}}</view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progress}}%;"></view>
    </view>
    <view class="progress-meta" wx:if="{{targetVersion}}">目标 {{targetVersion}} · {{progress}}%</view>
  </view>

  <view
    class="status-tip {{statusTipClass}}"
    wx:if="{{statusTip}}"
  >{{statusTip}}</view>

  <view class="status-tip warn" wx:if="{{loadError}}">{{loadError}}
    <button size="mini" bindtap="onShow" disabled="{{checking}}">重新读取设备</button>
  </view>

  <view class="weui-btn-area">
    <button wx:if="{{upgrading}}" class="weui-btn weui-btn_default" bindtap="onQueryUpgrade">查询升级进度</button>
    <view wx:if="{{upgrading}}" class="weui-cells__tips">可暂时离开本页，回来后继续核对设备状态</view>
    <button wx:if="{{resultUncertain}}" class="weui-btn weui-btn_primary" bindtap="onRecheckResult" loading="{{checking}}" disabled="{{checking}}">重新核对升级结果</button>
    <view wx:if="{{resultUncertain}}" class="weui-cells__tips">只查询上次升级的设备，不会再次下发升级</view>
    <button
      wx:if="{{!resultUncertain && !upgrading}}"
      class="weui-btn weui-btn_default"
      bindtap="onCheck"
      loading="{{checking}}"
      disabled="{{checking || upgrading}}"
    >检查更新</button>
  </view>
  <view class="weui-btn-area tight">
    <button
      class="weui-btn weui-btn_primary"
      bindtap="onUpgrade"
      loading="{{upgrading}}"
      disabled="{{!updateAvailable || checking || upgrading || resultUncertain}}"
    >立即升级</button>
  </view>

  <navigator class="weui-cells__tips" url="/pages/profile/profile" open-type="switchTab">丹青固件维护可到「我的」联系客服 ›</navigator>
  <view class="page-foot muted">动力巢科技 · {{footVersion}}</view>
</view>
