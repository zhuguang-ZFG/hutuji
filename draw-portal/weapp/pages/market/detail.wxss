.detail-page { padding: 34rpx 30rpx calc(48rpx + env(safe-area-inset-bottom)); background: var(--bg); min-height: 100vh; box-sizing: border-box; }
.work-heading { padding: 0 6rpx 30rpx; }
.eyebrow { color: var(--cyan); font-size: 22rpx; letter-spacing: 3rpx; }
.work-title { display: block; font-size: 44rpx; font-weight: 600; line-height: 1.4; margin: 12rpx 0 10rpx; }
.work-sub { color: var(--muted); font-size: 24rpx; }
.paper-frame { padding: 32rpx; height: 620rpx; box-sizing: border-box; background: #f9f8f3; border-radius: 18rpx; box-shadow: 0 20rpx 54rpx rgba(0,0,0,.24); }
.work-preview { width: 100%; height: 100%; }
.preview-placeholder { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 28rpx; color: #697172; font-size: 25rpx; }
.loading-line { width: 80rpx; height: 3rpx; background: #629395; animation: breathe 1.4s ease-in-out infinite; }
.preview-tip { margin-top: 18rpx; text-align: center; color: var(--muted); font-size: 22rpx; }
.credit-panel { margin-top: 28rpx; padding: 24rpx; border: 1rpx solid var(--line); border-radius: 16rpx; }
.credit-label { display: block; font-size: 22rpx; color: var(--muted); margin-bottom: 10rpx; }
.credit-text { display: block; font-size: 25rpx; color: var(--text); line-height: 1.6; word-break: break-all; }
.credit-change { display: block; margin-top: 8rpx; font-size: 22rpx; color: var(--muted); }
.send-panel { padding-top: 32rpx; }
.device-row { display: flex; align-items: center; gap: 12rpx; font-size: 25rpx; color: var(--muted); margin-bottom: 18rpx; }
.device-dot { width: 10rpx; height: 10rpx; background: var(--muted); border-radius: 50%; }
.device-dot.connected { background: var(--cyan); }
.send-credit { font-size: 22rpx; color: var(--muted); line-height: 1.6; margin: 0 0 20rpx; }
.send-button, .favorite-button { border-radius: 44rpx; font-size: 29rpx; line-height: 88rpx; font-weight: 500; }
.send-button { background: var(--cyan); color: #061016; }
.favorite-button { margin-top: 16rpx; background: var(--panel); color: var(--text); }
.send-button::after { border: 0; }
.favorite-button::after { border-color: var(--line); border-radius: 88rpx; }
button[disabled] { opacity: .5; }
.button-press { opacity: .8; }
.action-hint { display: block; margin: 24rpx 12rpx 0; font-size: 25rpx; color: var(--muted); line-height: 1.6; text-align: center; }
.error-panel { padding: 36rpx 8rpx; text-align: center; color: var(--muted); font-size: 26rpx; }
.retry-button { margin-top: 22rpx; border-radius: 30rpx; background: var(--panel-2); color: var(--cyan); font-size: 25rpx; }
@keyframes breathe { 50% { opacity: .25; transform: scaleX(.6); } }
