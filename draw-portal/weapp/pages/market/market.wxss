.market-page { min-height: 100vh; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); background: var(--bg); }
.gallery-intro { position: relative; padding: 44rpx 36rpx 40rpx; overflow: hidden; }
.eyebrow { color: var(--accent-text); font-size: 22rpx; letter-spacing: 3rpx; }
.gallery-title { position: relative; font-size: 54rpx; line-height: 1.38; font-weight: 600; margin: 18rpx 0 16rpx; letter-spacing: 1rpx; }
.title-accent { display: block; }
.gallery-sub { color: var(--muted); font-size: 25rpx; }
.intro-art { position: absolute; right: 32rpx; top: 68rpx; width: 190rpx; height: 200rpx; transform: rotate(-12deg); }
.art-orbit { position: absolute; width: 150rpx; height: 150rpx; border: 2rpx solid rgba(216, 95, 123,.32); border-radius: 50%; }
.art-stroke { position: absolute; left: 38rpx; top: 62rpx; width: 120rpx; height: 120rpx; border: 2rpx solid rgba(228,224,211,.5); border-radius: 20rpx 74rpx 16rpx 60rpx; }
.art-dot { position: absolute; width: 14rpx; height: 14rpx; border-radius: 50%; top: 16rpx; right: 14rpx; background: var(--cyan); box-shadow: 0 0 32rpx rgba(216, 95, 123,.3); }
.cat-bar { position: sticky; top: 0; z-index: 3; box-sizing: border-box; width: 100%; white-space: nowrap; padding: 20rpx 24rpx; background: var(--bg); border-bottom: 1rpx solid var(--line); }
.cat-chip { display: inline-block; margin-right: 14rpx; padding: 15rpx 24rpx; border: 1rpx solid var(--line); border-radius: 30rpx; color: var(--muted); font-size: 25rpx; }
.cat-count { margin-left: 10rpx; font-size: 20rpx; opacity: .65; }
.cat-chip.active { background: var(--pink); border-color: var(--cyan); color: #4d3a46; font-weight: 600; }
.gallery-grid { display: flex; flex-wrap: wrap; padding: 18rpx 18rpx 0; }
.gallery-card { box-sizing: border-box; width: calc(50% - 24rpx); margin: 12rpx; overflow: hidden; border-radius: 22rpx; border: 1rpx solid var(--line); background: var(--panel); }
.card-press { opacity: .8; }
.card-paper { height: 302rpx; padding: 22rpx; box-sizing: border-box; background: #f9f8f3; }
.card-img { width: 100%; height: 100%; }
.preview-placeholder { width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; color: #735f69; font-size: 22rpx; gap: 18rpx; }
.retry-mark { font-size: 40rpx; color: #3b7564; }
.card-meta { padding: 22rpx 20rpx; display: flex; align-items: center; justify-content: space-between; gap: 8rpx; }
.work-title { color: var(--text); font-size: 27rpx; line-height: 1.5; }
.card-arrow { color: var(--accent-text); font-size: 28rpx; flex-shrink: 0; }
.gallery-state { padding: 70rpx 42rpx; text-align: center; color: var(--muted); font-size: 26rpx; display: flex; flex-direction: column; align-items: center; gap: 24rpx; }
.state-title { font-size: 34rpx; color: var(--text); }
.state-button { margin: 8rpx auto; padding: 0 34rpx; border-radius: 32rpx; background: var(--panel-2); color: var(--accent-text); font-size: 26rpx; }
.state-button::after { border-color: var(--line); }
.gallery-notice { display: flex; align-items: center; gap: 20rpx; margin: 24rpx 30rpx 0; padding: 24rpx; border-radius: 18rpx; border: 1rpx solid rgba(200,86,104,.25); background: #fde7ea; color: #a3354d; font-size: 24rpx; line-height: 1.6; }
.notice-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.notice-title { font-size: 28rpx; font-weight: 600; color: #a3354d; }
.gallery-notice .state-button { flex-shrink: 0; width: auto; min-width: 104rpx; margin: 0; min-height: 88rpx; display: flex; align-items: center; justify-content: center; padding: 0 26rpx; }
.loading-line { width: 70rpx; height: 3rpx; animation: breathe 1.4s ease-in-out infinite; }
.empty-drawing { width: 92rpx; height: 112rpx; border: 2rpx solid var(--muted); border-radius: 8rpx 28rpx 8rpx 8rpx; transform: rotate(-8deg); opacity: .55; margin-bottom: 12rpx; }
.page-foot { padding: 32rpx; text-align: center; color: var(--muted); font-size: 23rpx; }
@keyframes breathe { 50% { opacity: .25; transform: scaleX(.6); } }
