@import "../../styles/weui-page.wxss";

.slim-head {
  margin: 20rpx 28rpx 8rpx;
}

.slim-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.work-cell {
  align-items: center;
}

.thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: #0b0c13;
  margin-right: 24rpx;
  flex-shrink: 0;
  border: 1rpx solid rgba(0, 209, 229, 0.2);
}

.thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.name {
  font-size: 32rpx;
  color: #f2f4f8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.send-btn {
  background: #00d1e5 !important;
  color: #061016 !important;
  border-radius: 999rpx !important;
  font-size: 24rpx !important;
  font-weight: 600 !important;
  padding: 0 28rpx !important;
  margin: 0;
  line-height: 2;
}

.send-btn::after {
  border: none;
}

.empty-panel {
  margin: 120rpx 48rpx 0;
  text-align: center;
}

.empty-glyph {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 28rpx;
  border-radius: 24rpx;
  border: 4rpx dashed rgba(0, 209, 229, 0.4);
  box-shadow: inset 0 0 0 20rpx rgba(0, 209, 229, 0.12);
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #9aa3b5;
  line-height: 1.5;
}

.skeleton-list {
  margin: 28rpx 24rpx;
}

.skeleton-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: #14151f;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.sk-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #1a1b28, #222433, #1a1b28);
  margin-right: 24rpx;
  flex-shrink: 0;
}

.sk-body {
  flex: 1;
}

.sk-line {
  height: 22rpx;
  border-radius: 8rpx;
  background: #1a1b28;
  margin-bottom: 16rpx;
}

.sk-line.w70 {
  width: 70%;
}

.sk-line.w40 {
  width: 40%;
  margin-bottom: 0;
}

.sk-pulse {
  background: #1a1b28;
}

.row-press {
  background: rgba(0, 209, 229, 0.06);
}

.btn-press {
  opacity: 0.85;
}
