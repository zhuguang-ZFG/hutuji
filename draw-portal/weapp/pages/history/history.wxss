@import "../../styles/weui-page.wxss";

.slim-head {
  margin: 20rpx 28rpx 8rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.slim-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #4d3a46;
}

.work-cell {
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
  padding: 26rpx;
  border-radius: 22rpx;
  background: #fffdf8;
  border: 1rpx solid rgba(77, 58, 70, 0.16);
}
.work-list { margin: 0 24rpx; }
.work-cell::before { display: none; }
.work-cell .weui-cell__bd { min-width: 0; }

.thumb {
  width: 136rpx;
  height: 136rpx;
  border-radius: 16rpx;
  background: #fff7ed;
  margin-right: 24rpx;
  flex-shrink: 0;
  border: 1rpx solid rgba(216, 95, 123, 0.2);
}

.thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #735f69;
}

.thumb-retry {
  color: #b03f5a;
  border-style: dashed;
}

.preview-error {
  font-size: 22rpx;
  color: #ac384a;
  white-space: normal;
}

.name {
  font-size: 32rpx;
  color: #4d3a46;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-all;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.row-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  width: 100%;
  justify-content: flex-end;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(77, 58, 70, 0.14);
}

.redraw-btn,
.send-btn,
.del-btn {
  border-radius: 999rpx !important;
  font-size: 24rpx !important;
  font-weight: 600 !important;
  padding: 0 24rpx !important;
  margin: 0;
  line-height: 2;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
}

.del-btn {
  background: transparent !important;
  color: #735f69 !important;
  border: 1rpx solid rgba(77, 58, 70, 0.25) !important;
}

.send-btn::after,
.del-btn::after {
  border: none;
}

.redraw-btn {
  background: transparent !important;
  color: #b03f5a !important;
  border: 1rpx solid rgba(216, 95, 123, 0.6) !important;
}

.redraw-btn::after {
  border: none;
}

.chips {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  padding: 4rpx 32rpx 20rpx;
}

.chip {
  font-size: 24rpx;
  color: #735f69;
  border-radius: 999rpx;
  padding: 14rpx 26rpx;
}

.chip-on {
  color: #4d3a46;
  background: #f3a3b5;
  font-weight: 600;
}

.empty-panel {
  margin: 120rpx 48rpx 0;
  text-align: center;
}

.empty-glyph {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 28rpx;
  border-radius: 24rpx;
  border: 4rpx dashed rgba(216, 95, 123, 0.4);
  box-shadow: inset 0 0 0 20rpx rgba(216, 95, 123, 0.12);
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #4d3a46;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #735f69;
  line-height: 1.5;
}

.skeleton-list {
  margin: 28rpx 24rpx;
}

.skeleton-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: #fffdf8;
  border: 1rpx solid rgba(77, 58, 70, 0.16);
}

.sk-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.sk-body {
  flex: 1;
}

.sk-line {
  height: 22rpx;
  border-radius: 8rpx;
  background: #fffdf8;
  margin-bottom: 16rpx;
}

.sk-line.w70 {
  width: 70%;
}

.sk-line.w40 {
  width: 40%;
  margin-bottom: 0;
}

.sk-pulse {
  background: #fffdf8;
}

.row-press {
  background: rgba(216, 95, 123, 0.06);
}

.btn-press {
  opacity: 0.85;
}

.result-count { color: #735f69; font-size: 24rpx; }
.search-row { display: flex; gap: 12rpx; align-items: center; margin: 20rpx 28rpx; }
.work-search { min-width: 0; flex: 1; border: 1rpx solid #303747; border-radius: 14rpx; padding: 18rpx; color: #4d3a46; font-size: 26rpx; }
.search-clear, .search-sort { margin: 0; padding: 0 12rpx; flex-shrink: 0; background: transparent; color: #b03f5a; font-size: 23rpx; }
.search-clear::after, .search-sort::after { border: none; }
.empty-action { margin-top: 28rpx; background: #f3a3b5; color: #4d3a46; font-size: 28rpx; border-radius: 16rpx; }

.generation-note {
  margin: 20rpx 28rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  color: #b03f5a;
  background: rgba(216, 95, 123, 0.08);
  font-size: 26rpx;
  line-height: 1.6;
}
.history-notice { display: flex; align-items: center; gap: 24rpx; margin: 24rpx; padding: 26rpx; border-radius: 18rpx; background: rgba(240,186,120,.06); border: 1rpx solid rgba(240,186,120,.25); color: #815c13; font-size: 24rpx; line-height: 1.6; }
.history-notice > view { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.notice-title { font-size: 28rpx; font-weight: 600; }
.history-notice button { margin: 0; min-height: 88rpx; display: flex; align-items: center; flex-shrink: 0; color: #b03f5a; background: #fdebdc; }
