.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.work {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #F6F1E6;
  flex-shrink: 0;
}

.info {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.send-btn {
  flex-shrink: 0;
}

.empty {
  text-align: center;
  padding: 60rpx 32rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
