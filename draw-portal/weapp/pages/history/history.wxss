.page {
  padding: 24rpx;
  background: #F6F1E6;
  min-height: 100vh;
}
.card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #F6F1E6;
  flex-shrink: 0;
}
.info {
  flex: 1;
  margin: 0 20rpx;
  overflow: hidden;
}
.name {
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A2E;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.btn.small {
  background: #2E6E65;
  color: #fff;
  font-size: 26rpx;
  flex-shrink: 0;
}
.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 120rpx 0;
}
