<view class="page">
  <view wx:if="{{loadError}}" class="history-notice"><view><text class="notice-title">作品暂时无法读取</text><text>{{loadError}}</text></view>
    <button size="mini" bindtap="onRetry" loading="{{loading}}" disabled="{{loading}}">重试</button>
  </view>
  <view class="generation-note" wx:if="{{redrawing}}">正在生成作品… 可先查看其他页面，回到这里后继续预览。</view>
  <block wx:if="{{loading && !jobs.length}}">
    <view class="skeleton-list">
      <view class="skeleton-row" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="sk-thumb"></view>
        <view class="sk-body">
          <view class="sk-line w70"></view>
          <view class="sk-line w40"></view>
        </view>
      </view>
    </view>
  </block>

  <block wx:elif="{{!jobs.length && !loadError}}">
    <view class="empty-panel">
      <view class="empty-glyph"></view>
      <view class="empty-title">还没有收藏</view>
      <view class="empty-sub">去「创作」生成预览后点「收藏」，或跟「小派」聊聊</view>
      <button class="empty-action" bindtap="onGoCreate">去创作第一件作品</button>
    </view>
  </block>

  <block wx:elif="{{jobs.length}}">
    <view class="slim-head">
      <text class="slim-title">我的作品</text>
      <text class="result-count">{{filtered.length}} / {{jobs.length}} 件</text>
    </view>
    <view class="search-row">
      <input class="work-search" value="{{searchText}}" bindinput="onSearch" placeholder="搜索作品名称或内容" maxlength="80" confirm-type="search" aria-label="搜索作品" />
      <button wx:if="{{searchText}}" size="mini" class="search-clear" bindtap="onClearSearch">清空</button>
      <button size="mini" class="search-sort" bindtap="onSortToggle">{{sortOrder === 'oldest' ? '最早优先' : '最新优先'}}</button>
    </view>
    <view class="chips">
      <view
        wx:for="{{kinds}}"
        wx:key="key"
        class="chip {{filterKind === item.key ? 'chip-on' : ''}}"
        bindtap="onFilter"
        data-kind="{{item.key}}"
      >{{item.label}}</view>
    </view>
    <block wx:if="{{!filtered.length}}">
      <view class="empty-panel">
        <view class="empty-title">{{searchText ? '没有找到匹配作品' : '该类暂无作品'}}</view>
        <view class="empty-sub">换个关键词，或清空筛选查看全部作品</view>
        <button class="empty-action" bindtap="onClearFilters">查看全部作品</button>
      </view>
    </block>
    <view class="work-list" wx:else>
      <view class="weui-cell work-cell" wx:for="{{filtered}}" wx:key="savedId" hover-class="row-press" bindlongpress="onLongPress" data-id="{{item.savedId}}" data-idx="{{index}}">
        <view class="weui-cell__hd">
          <image
            wx:if="{{item.previewUrl}}"
            class="thumb"
            src="{{item.previewUrl}}"
            mode="aspectFit"
            bindtap="onPreview"
            binderror="onPreviewError"
            data-id="{{item.savedId}}"
            data-url="{{item.previewUrl}}"
          />
          <view wx:elif="{{item.previewState === 'error'}}" class="thumb thumb-placeholder thumb-retry"
            bindtap="onRetryPreview" data-id="{{item.savedId}}">点击重试</view>
          <view wx:else class="thumb thumb-placeholder sk-pulse">加载中</view>
        </view>
        <view class="weui-cell__bd">
          <view class="name">{{item.sourceName}}</view>
          <view class="muted">{{item.createdAt}}</view>
          <view wx:if="{{item.credit && item.credit.attribution}}" class="muted">{{item.credit.attribution}}</view>
          <view wx:if="{{item.previewError}}" class="preview-error">{{item.previewError}}</view>
        </view>
        <view class="weui-cell__ft row-actions">
          <button wx:if="{{item.kind}}" class="redraw-btn" size="mini" hover-class="btn-press" bindtap="onRedraw" data-id="{{item.savedId}}" disabled="{{redrawing}}">重画</button>
          <button class="del-btn" size="mini" hover-class="btn-press" bindtap="onDelete" data-id="{{item.savedId}}" disabled="{{!!deletingId}}">{{deletingId === item.savedId ? '删除中' : '删除'}}</button>
          <button class="send-btn" size="mini" hover-class="btn-press" bindtap="onSend" data-id="{{item.savedId}}" disabled="{{!!sendingId}}" loading="{{sendingId === item.savedId}}">{{sendingId === item.savedId ? '发送中' : '发送'}}</button>
        </view>
      </view>
    </view>
    <view class="weui-cells__tips">长按可删除不要的作品</view>
  </block>
</view>
