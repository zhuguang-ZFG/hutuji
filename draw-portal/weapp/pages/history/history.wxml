<view class="page">
  <view class="empty card" wx:if="{{!jobs.length && !loading}}">
    <view class="empty-text">还没有收藏的作品</view>
    <view class="muted">去首页画一个，或拍张照片试试</view>
  </view>
  <view class="card work" wx:for="{{jobs}}" wx:key="savedId">
    <image wx:if="{{item.previewUrl}}" class="thumb" src="{{item.previewUrl}}" mode="aspectFill" bindtap="onPreview" data-url="{{item.previewUrl}}" />
    <view wx:else class="thumb thumb-placeholder"><text class="muted">加载中…</text></view>
    <view class="info">
      <view class="name">{{item.sourceName}}</view>
      <view class="muted">{{item.createdAt}}</view>
    </view>
    <button class="btn-ghost send-btn" size="mini" bindtap="onSend" data-id="{{item.savedId}}">发送</button>
  </view>
  <view class="muted empty" wx:if="{{loading}}">加载中…</view>
</view>
