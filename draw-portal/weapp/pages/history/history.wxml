<view class="page">
  <view class="empty" wx:if="{{!jobs.length && !loading}}">还没有作品，去首页画一个</view>
  <view class="card" wx:for="{{jobs}}" wx:key="jobId">
    <image class="thumb" src="{{item.previewUrl}}" mode="aspectFill" bindtap="onPreview" data-url="{{item.previewUrl}}" />
    <view class="info">
      <view class="name">{{item.sourceName}}</view>
      <view class="meta">{{item.createdAt}} · {{item.lines}} 行</view>
    </view>
    <button class="btn small" size="mini" bindtap="onSend" data-id="{{item.jobId}}">发送</button>
  </view>
  <view class="empty" wx:if="{{loading}}">加载中…</view>
</view>
