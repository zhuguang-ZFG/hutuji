<view class="page">
  <view wx:if="{{loadError}}" class="weui-cells__tips">{{loadError}}
    <button size="mini" bindtap="refresh">重新读取</button>
  </view>
  <block wx:if="{{loading && !jobs.length}}">
    <view class="skeleton-list">
      <view class="skeleton-row" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="sk-thumb"></view>
        <view class="sk-body">
          <view class="sk-line w70"></view>
          <view class="sk-line w40"></view>
        </view>
      </view>
    </view>
  </block>

  <block wx:elif="{{!jobs.length && !loadError}}">
    <view class="empty-panel">
      <view class="empty-glyph"></view>
      <view class="empty-title">还没有收藏</view>
      <view class="empty-sub">去「创作」生成预览后点「收藏」，或跟「小派」聊聊</view>
    </view>
  </block>

  <block wx:else>
    <view class="slim-head">
      <text class="slim-title">我的作品</text>
    </view>
    <view class="chips">
      <view
        wx:for="{{kinds}}"
        wx:key="key"
        class="chip {{filterKind === item.key ? 'chip-on' : ''}}"
        bindtap="onFilter"
        data-kind="{{item.key}}"
      >{{item.label}}</view>
    </view>
    <block wx:if="{{!filtered.length}}">
      <view class="empty-panel">
        <view class="empty-title">该类暂无作品</view>
        <view class="empty-sub">切换筛选或去「创作」生成</view>
      </view>
    </block>
    <view class="weui-cells" wx:else>
      <view class="weui-cell work-cell" wx:for="{{filtered}}" wx:key="savedId" hover-class="row-press" bindlongpress="onLongPress" data-id="{{item.savedId}}" data-idx="{{index}}">
        <view class="weui-cell__hd">
          <image
            wx:if="{{item.previewUrl}}"
            class="thumb"
            src="{{item.previewUrl}}"
            mode="aspectFill"
            bindtap="onPreview"
            data-url="{{item.previewUrl}}"
          />
          <view wx:else class="thumb thumb-placeholder sk-pulse"></view>
        </view>
        <view class="weui-cell__bd">
          <view class="name">{{item.sourceName}}</view>
          <view class="muted">{{item.createdAt}}</view>
        </view>
        <view class="weui-cell__ft row-actions">
          <button wx:if="{{item.kind}}" class="redraw-btn" size="mini" hover-class="btn-press" bindtap="onRedraw" data-idx="{{index}}">重画</button>
          <button class="del-btn" size="mini" hover-class="btn-press" bindtap="onDelete" data-id="{{item.savedId}}" disabled="{{!!deletingId}}">删除</button>
          <button class="send-btn" size="mini" hover-class="btn-press" bindtap="onSend" data-id="{{item.savedId}}" disabled="{{!!sendingId}}">{{sendingId === item.savedId ? '发送中' : '发送'}}</button>
        </view>
      </view>
    </view>
    <view class="weui-cells__tips">长按可删除不要的作品</view>
  </block>
</view>
