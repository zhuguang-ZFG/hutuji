<view class="page">
  <view class="card" wx:if="{{step === 'input'}}">
    <view class="title">绑定写字机</view>
    <view class="steps">
      <view class="step">1. 对写字机说「绑定」或按设备绑定入口，屏幕会显示 6 位绑定码</view>
      <view class="step">2. 在下方输入绑定码</view>
    </view>
    <input
      class="code-input"
      placeholder="6 位绑定码"
      value="{{code}}"
      bindinput="onCodeInput"
      maxlength="6"
    />
    <button
      class="btn primary"
      bindtap="onSubmit"
      loading="{{submitting}}"
      disabled="{{submitting || code.length !== 6}}"
    >
      绑定
    </button>
  </view>

  <view class="card" wx:if="{{step === 'waiting'}}">
    <view class="title">等待设备确认</view>
    <view class="meta">绑定码：{{code}}</view>
    <view class="meta">请在写字机屏幕/语音上确认绑定（10 分钟内有效）</view>
    <button class="btn" bindtap="onRefresh">我已确认，刷新状态</button>
    <button class="btn" bindtap="onReset">重新输入绑定码</button>
  </view>

  <view class="card" wx:if="{{step === 'bound'}}">
    <view class="title">绑定成功</view>
    <view class="meta">设备尾号 {{macSuffix}}</view>
    <button class="btn primary" bindtap="onBack">返回首页</button>
    <button class="btn danger" bindtap="onUnbind">解绑设备</button>
  </view>
</view>
