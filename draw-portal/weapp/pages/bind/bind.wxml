<view class="page">
  <block wx:if="{{step === 'input'}}">
    <view class="hero">
      <view class="hero-brand">动力巢科技 · 小派</view>
      <view class="hero-title">绑定<span class="accent">写字机</span></view>
      <view class="hero-sub">对写字机说「绑定」，屏幕出现二维码后扫码或手输 6 位码</view>
    </view>
    <view class="weui-btn-area">
      <button class="weui-btn weui-btn_primary" bindtap="onScanBind">扫码一键绑定</button>
    </view>
    <view class="divider">
      <view class="divider-line"></view>
      <view class="divider-text">或手动输入</view>
      <view class="divider-line"></view>
    </view>
    <view class="weui-cells">
      <view class="weui-cell">
        <view class="weui-cell__bd">
          <input
            class="code-input"
            placeholder="6 位绑定码"
            placeholder-class="ph"
            value="{{code}}"
            bindinput="onCodeInput"
            maxlength="6"
          />
        </view>
      </view>
    </view>
    <view class="weui-btn-area">
      <button
        class="weui-btn weui-btn_primary"
        bindtap="onSubmit"
        loading="{{submitting}}"
        disabled="{{submitting || code.length !== 6}}"
      >
        绑定
      </button>
    </view>
  </block>

  <block wx:if="{{step === 'waiting'}}">
    <view class="hero">
      <view class="hero-brand">动力巢科技 · 小派</view>
      <view class="hero-title">正在连接…</view>
      <view class="hero-sub">绑定码：{{code}} · 正在等写字机联网确认（已等 {{waitSeconds}} 秒）…</view>
    </view>
    <view class="weui-btn-area">
      <button class="weui-btn weui-btn_default" bindtap="onReset">重新扫码</button>
    </view>
  </block>

  <block wx:if="{{step === 'bound'}}">
    <view class="hero">
      <view class="hero-brand">动力巢科技 · 小派</view>
      <view class="hero-title">绑定<span class="accent">成功</span></view>
      <view class="hero-sub">设备尾号 {{macSuffix}}</view>
    </view>
    <view class="weui-btn-area">
      <button class="weui-btn weui-btn_primary" bindtap="onBack">返回首页</button>
    </view>
    <view class="weui-btn-area tight">
      <button class="weui-btn weui-btn_warn" bindtap="onUnbind">解绑设备</button>
    </view>
  </block>
</view>
