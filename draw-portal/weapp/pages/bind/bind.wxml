<view class="page">
  <view class="card" wx:if="{{step === 'input'}}">
    <view class="title">绑定写字机</view>
    <view class="subtitle">对写字机说「绑定」，屏幕出现二维码后：</view>
    <button class="btn scan" bindtap="onScanBind">
      <text class="scan-icon">⌗</text>
      扫码一键绑定
    </button>
    <view class="divider">
      <view class="divider-line"></view>
      <view class="divider-text">或手动输入</view>
      <view class="divider-line"></view>
    </view>
    <input
      class="code-input"
      placeholder="6 位绑定码"
      value="{{code}}"
      bindinput="onCodeInput"
      maxlength="6"
    />
    <button
      class="btn primary"
      bindtap="onSubmit"
      loading="{{submitting}}"
      disabled="{{submitting || code.length !== 6}}"
    >
      绑定
    </button>
  </view>

  <view class="card" wx:if="{{step === 'waiting'}}">
    <view class="title">正在连接写字机…</view>
    <view class="meta">绑定码：{{code}}</view>
    <view class="meta">写字机联网确认后会自动完成，请稍等</view>
    <button class="btn ghost" bindtap="onReset">重新扫码</button>
  </view>

  <view class="card" wx:if="{{step === 'bound'}}">
    <view class="success-badge">✓</view>
    <view class="title center">绑定成功</view>
    <view class="meta center">设备尾号 {{macSuffix}}</view>
    <button class="btn primary" bindtap="onBack">返回首页</button>
    <button class="btn danger" bindtap="onUnbind">解绑设备</button>
  </view>
</view>
