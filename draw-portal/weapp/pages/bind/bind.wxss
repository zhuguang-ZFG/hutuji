.page {
  padding: 24rpx;
  background: #F6F1E6;
  min-height: 100vh;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A1A2E;
  margin-bottom: 16rpx;
}
.steps {
  margin-bottom: 20rpx;
}
.step {
  font-size: 26rpx;
  color: #555;
  margin-bottom: 12rpx;
  line-height: 1.6;
}
.meta {
  font-size: 26rpx;
  color: #888;
  margin: 12rpx 0;
}
.code-input {
  background: #F6F1E6;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 40rpx;
  letter-spacing: 12rpx;
  text-align: center;
  margin-bottom: 16rpx;
}
.btn {
  margin-top: 16rpx;
  background: #E8E4DA;
  color: #1A1A2E;
  border-radius: 16rpx;
  font-size: 30rpx;
}
.btn.primary {
  background: #2E6E65;
  color: #fff;
}
.btn.danger {
  background: #fff;
  color: #B3403A;
}
