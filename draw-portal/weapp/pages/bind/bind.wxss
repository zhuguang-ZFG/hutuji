.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #555;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.btn.scan {
  background: #1A1A2E;
  color: #B4F0FF;
  border-radius: 999rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn.scan::after {
  border: none;
}

.scan-icon {
  font-size: 40rpx;
}

.divider {
  display: flex;
  align-items: center;
  margin: 32rpx 0;
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background: #E8E4DA;
}

.divider-text {
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #8A8A99;
}

.code-input {
  background: #F6F1E6;
  border-radius: 16rpx;
  padding: 22rpx;
  font-size: 44rpx;
  letter-spacing: 16rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.btn {
  margin-top: 16rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.btn::after {
  border: none;
}

.btn.primary {
  background: #2E6E65;
  color: #fff;
}

.btn.ghost {
  background: #fff;
  color: #2E6E65;
  border: 2rpx solid #2E6E65;
}

.btn.danger {
  background: #fff;
  color: #B3403A;
  border: 2rpx solid #B3403A;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 16rpx;
}

.title.center {
  text-align: center;
}

.meta {
  font-size: 26rpx;
  color: #8A8A99;
  margin: 12rpx 0;
}

.meta.center {
  text-align: center;
}

.success-badge {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #2E6E65;
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}
