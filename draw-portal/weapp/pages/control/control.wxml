<view class="page control-page">
  <view class="control-error" wx:if="{{statusError}}">
    <text>{{statusError}}</text>
    <button size="mini" bindtap="onRetrySpeed">刷新</button>
  </view>
  <view class="empty-panel" wx:if="{{!bindingChecked}}">
    <view class="empty-title">{{bindingLoading ? '正在读取设备…' : '暂时无法读取设备'}}</view>
    <view class="empty-sub">{{bindingLoading ? '请稍候' : '请检查网络后点击刷新'}}</view>
  </view>
  <block wx:elif="{{!bound}}">
    <view class="empty-panel">
      <view class="empty-glyph"></view>
      <view class="empty-title">还没绑定丹青</view>
      <view class="empty-sub">绑定后才能点动、抬落笔和控制任务</view>
      <button class="weui-btn weui-btn_primary empty-cta" hover-class="btn-press" bindtap="onGoBind">去绑定</button>
    </view>
  </block>

  <block wx:else>
    <navigator url="/pages/paper/paper" class="control-paper-link"><text>{{status && status.paper_config && status.paper_config.config ? status.paper_config.config.paper + (status.paper_config.config.landscape ? ' · 横向' : ' · 竖向') : '纸张与方向'}}</text><text>设置 ›</text></navigator>
    <view class="status-card">
      <view class="status-top">
        <view class="status-left">
          <view class="status-dot {{linkOk ? 'ok' : (status ? 'bad' : '')}}"></view>
          <text class="status-main">{{linkLabel}}</text>
        </view>
        <text class="status-state">{{stateLabel || '—'}}</text>
      </view>
      <view class="status-bottom" wx:if="{{statusLine}}">{{statusLine}}</view>
      <view class="control-error" wx:if="{{controlError}}">{{controlError}}</view>
      <view class="control-error" wx:if="{{deviceError}}">设备报告：{{deviceError}}</view>
      <view class="control-error" wx:if="{{actionError}}">操作结果：{{actionError}}</view>
      <view class="timeline" wx:if="{{status}}">
        <block wx:for="{{timelineLabels}}" wx:key="*this">
          <view class="timeline-step {{index === timelineIndex ? 'active' : ''}} {{index < timelineIndex ? 'done' : ''}}">
            <view class="timeline-dot"></view>
            <text class="timeline-lab">{{item}}</text>
          </view>
        </block>
      </view>
      <view class="timeline-hint" wx:if="{{timelineHint}}">{{timelineHint}}</view>
      <view class="eta-row" wx:if="{{elapsedLabel || etaLabel}}">
        <text wx:if="{{elapsedLabel}}">已画 {{elapsedLabel}}</text>
        <text wx:if="{{elapsedLabel && etaLabel}}"> · </text>
        <text wx:if="{{etaLabel}}">预计 {{etaLabel}}</text>
      </view>
      <view class="page-bar-wrap" wx:if="{{pageShow}}">
        <view class="page-bar-meta">页 {{pageLabel}}</view>
        <view class="page-bar-track">
          <view class="page-bar-fill" style="width: {{pagePercent}}%;"></view>
        </view>
      </view>
      <view class="ota-line" wx:if="{{otaLine}}">{{otaLine}}</view>
    </view>

    <view class="confirm-row" wx:if="{{canConfirm}}">
      <button
        class="weui-btn weui-btn_primary confirm-btn"
        hover-class="btn-press"
        bindtap="onConfirm"
        disabled="{{!!busyAction || speedLoading || speedSaving}}"
        loading="{{busyAction === 'hutuji.confirm'}}"
      >开始画</button>
    </view>

    <view class="jog-block">
      <view class="jog-meta">
        <text class="jog-label">点动</text>
        <button class="step-pill" hover-class="tile-press" bindtap="onStepToggle" disabled="{{manualLocked || speedLoading || speedSaving}}">{{step}} mm</button>
      </view>
      <!-- 3×3 网格：避开 button 默认 min-width 把左右键挤出卡片 -->
      <view class="dpad">
        <view class="dpad-btn spacer"></view>
        <button class="dpad-btn" hover-class="dpad-press" bindtap="onJog" data-dir="jog_y+" disabled="{{manualLocked || speedLoading || speedSaving}}">前</button>
        <view class="dpad-btn spacer"></view>
        <button class="dpad-btn" hover-class="dpad-press" bindtap="onJog" data-dir="jog_x-" disabled="{{manualLocked || speedLoading || speedSaving}}">左</button>
        <button class="dpad-btn home" hover-class="dpad-press" bindtap="onHome" disabled="{{manualLocked || speedLoading || speedSaving}}">原点</button>
        <button class="dpad-btn" hover-class="dpad-press" bindtap="onJog" data-dir="jog_x+" disabled="{{manualLocked || speedLoading || speedSaving}}">右</button>
        <view class="dpad-btn spacer"></view>
        <button class="dpad-btn" hover-class="dpad-press" bindtap="onJog" data-dir="jog_y-" disabled="{{manualLocked || speedLoading || speedSaving}}">后</button>
        <view class="dpad-btn spacer"></view>
      </view>
      <view class="pen-row">
        <button class="pen-btn" hover-class="tile-press" bindtap="onPen" data-action="pen_up" disabled="{{manualLocked || speedLoading || speedSaving}}">抬笔</button>
        <button class="pen-btn" hover-class="tile-press" bindtap="onPen" data-action="pen_down" disabled="{{manualLocked || speedLoading || speedSaving}}">落笔</button>
        <button class="pen-btn" hover-class="tile-press" bindtap="onPenTest" disabled="{{manualLocked || speedLoading || speedSaving}}">试笔</button>
      </view>
    </view>

    <view class="job-row">
      <button class="job-btn" hover-class="tile-press" bindtap="onJobAction" data-tool="hutuji.pause" disabled="{{!canPause || !!busyAction || speedLoading || speedSaving}}">暂停</button>
      <button class="job-btn" hover-class="tile-press" bindtap="onJobAction" data-tool="hutuji.resume" disabled="{{!canResume || !!busyAction || speedLoading || speedSaving}}">继续</button>
      <button class="job-btn" hover-class="tile-press" bindtap="onJobAction" data-tool="hutuji.repeat" disabled="{{!!busyAction || !canRepeat || speedLoading || speedSaving}}">重画</button>
      <button class="job-btn danger" hover-class="tile-press" bindtap="onStop" disabled="{{!!busyAction || !canAbort || speedLoading || speedSaving}}">停止</button>
    </view>

    <view class="speed-block">
      <text class="speed-label">分轴速度</text>
      <view wx:for="{{speedAxes}}" wx:key="key" class="speed-axis">
        <view class="speed-meta">
          <text class="speed-axis-label">{{item.label}}</text>
          <text class="speed-val">{{speedLoaded ? speedRates[item.key] + ' 毫米/分' : '未读取'}}</text>
        </view>
        <slider
          class="speed-slider"
          min="{{item.min}}"
          max="{{item.max}}"
          step="{{item.step}}"
          value="{{speedRates[item.key]}}"
          activeColor="#00d1e5"
          backgroundColor="rgba(255,255,255,0.08)"
          block-size="22"
          disabled="{{speedSaving || speedLoading || !speedLoaded || !!busyAction || !canSetSpeed}}"
          data-axis="{{item.key}}"
          bindchange="onSpeedChange"
        />
      </view>
      <view class="speed-hint" wx:if="{{speedLoading}}">正在读取机器速度…</view>
      <view class="speed-hint" wx:elif="{{speedSaving}}">正在确认调整结果…</view>
      <view class="speed-error" wx:elif="{{speedError}}">{{speedError}}</view>
      <view class="speed-hint" wx:else>{{speedHint}}</view>
      <button class="speed-retry" size="mini" wx:if="{{!speedLoaded && !speedLoading && !speedSaving}}" bindtap="onRetrySpeed">重新读取速度</button>
      <view class="speed-hint">X/Y 默认 10000，Z 单独控制抬落笔。画图和空走都受轴速度上限限制。</view>
    </view>

    <view class="page-foot muted">动力巢科技 · {{footVersion}}</view>
  </block>
</view>
