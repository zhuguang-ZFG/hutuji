<view class="page control-page">
  <block wx:if="{{!bound}}">
    <view class="empty-panel">
      <view class="empty-glyph"></view>
      <view class="empty-title">还没绑定写字机</view>
      <view class="empty-sub">绑定后才能点动、抬落笔和控制任务</view>
      <button class="weui-btn weui-btn_primary empty-cta" hover-class="btn-press" bindtap="onGoBind">去绑定</button>
    </view>
  </block>

  <block wx:else>
    <view class="status-card">
      <view class="status-top">
        <view class="status-left">
          <view class="status-dot {{linkOk ? 'ok' : (status ? 'bad' : '')}}"></view>
          <text class="status-main">{{linkLabel}}</text>
        </view>
        <text class="status-state">{{stateLabel || '—'}}</text>
      </view>
      <view class="status-bottom" wx:if="{{statusLine}}">{{statusLine}}</view>
      <view class="timeline" wx:if="{{status}}">
        <block wx:for="{{timelineLabels}}" wx:key="*this">
          <view class="timeline-step {{index === timelineIndex ? 'active' : ''}} {{index < timelineIndex ? 'done' : ''}}">
            <view class="timeline-dot"></view>
            <text class="timeline-lab">{{item}}</text>
          </view>
        </block>
      </view>
      <view class="timeline-hint" wx:if="{{timelineHint}}">{{timelineHint}}</view>
      <view class="eta-row" wx:if="{{elapsedLabel || etaLabel}}">
        <text wx:if="{{elapsedLabel}}">已画 {{elapsedLabel}}</text>
        <text wx:if="{{elapsedLabel && etaLabel}}"> · </text>
        <text wx:if="{{etaLabel}}">预计 {{etaLabel}}</text>
      </view>
      <view class="page-bar-wrap" wx:if="{{pageShow}}">
        <view class="page-bar-meta">页 {{pageLabel}}</view>
        <view class="page-bar-track">
          <view class="page-bar-fill" style="width: {{pagePercent}}%;"></view>
        </view>
      </view>
      <view class="ota-line" wx:if="{{otaLine}}">{{otaLine}}</view>
    </view>

    <view class="confirm-row" wx:if="{{canConfirm}}">
      <button
        class="weui-btn weui-btn_primary confirm-btn"
        hover-class="btn-press"
        bindtap="onConfirm"
        disabled="{{!!busyAction}}"
        loading="{{busyAction === 'hutuji.confirm'}}"
      >开始画</button>
    </view>

    <view class="jog-block">
      <view class="jog-meta">
        <text class="jog-label">点动</text>
        <view class="step-pill" hover-class="tile-press" bindtap="onStepToggle">{{step}} mm</view>
      </view>
      <!-- 3×3 网格：避开 button 默认 min-width 把左右键挤出卡片 -->
      <view class="dpad">
        <view class="dpad-btn spacer"></view>
        <button class="dpad-btn" hover-class="dpad-press" bindtap="onJog" data-dir="jog_y+" disabled="{{manualLocked}}">前</button>
        <view class="dpad-btn spacer"></view>
        <button class="dpad-btn" hover-class="dpad-press" bindtap="onJog" data-dir="jog_x-" disabled="{{manualLocked}}">左</button>
        <button class="dpad-btn home" hover-class="dpad-press" bindtap="onHome" disabled="{{manualLocked}}">原点</button>
        <button class="dpad-btn" hover-class="dpad-press" bindtap="onJog" data-dir="jog_x+" disabled="{{manualLocked}}">右</button>
        <view class="dpad-btn spacer"></view>
        <button class="dpad-btn" hover-class="dpad-press" bindtap="onJog" data-dir="jog_y-" disabled="{{manualLocked}}">后</button>
        <view class="dpad-btn spacer"></view>
      </view>
      <view class="pen-row">
        <button class="pen-btn" hover-class="tile-press" bindtap="onPen" data-action="pen_up" disabled="{{manualLocked}}">抬笔</button>
        <button class="pen-btn" hover-class="tile-press" bindtap="onPen" data-action="pen_down" disabled="{{manualLocked}}">落笔</button>
        <button class="pen-btn" hover-class="tile-press" bindtap="onPenTest" disabled="{{manualLocked}}">试笔</button>
      </view>
    </view>

    <view class="job-row">
      <button class="job-btn" hover-class="tile-press" bindtap="onJobAction" data-tool="hutuji.pause" disabled="{{!canPause || !!busyAction}}">暂停</button>
      <button class="job-btn" hover-class="tile-press" bindtap="onJobAction" data-tool="hutuji.resume" disabled="{{!canResume || !!busyAction}}">继续</button>
      <button class="job-btn" hover-class="tile-press" bindtap="onJobAction" data-tool="hutuji.repeat" disabled="{{!!busyAction}}">重画</button>
      <button class="job-btn danger" hover-class="tile-press" bindtap="onStop" disabled="{{!!busyAction || !canAbort}}">停止</button>
    </view>

    <view class="page-foot muted">动力巢 · v0.2.16</view>
  </block>
</view>
