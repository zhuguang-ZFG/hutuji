@import "../../styles/weui-page.wxss";

.control-page {
  padding-bottom: 20rpx;
  overflow-x: hidden;
}

.empty-panel {
  margin: 80rpx 40rpx 0;
  text-align: center;
}

.empty-glyph {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 28rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(0, 209, 229, 0.35);
  box-shadow: 0 0 0 16rpx rgba(0, 209, 229, 0.08), inset 0 0 0 22rpx rgba(0, 209, 229, 0.2);
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #9aa3b5;
  line-height: 1.5;
  margin-bottom: 36rpx;
}

.empty-cta {
  line-height: 2.2 !important;
}

.status-card {
  margin: 16rpx 28rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #14151f;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.status-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.status-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.status-main {
  font-size: 28rpx;
  color: #f2f4f8;
  font-weight: 600;
}

.status-state {
  font-size: 24rpx;
  color: #00d1e5;
  flex-shrink: 0;
}

.status-bottom {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9aa3b5;
}

.confirm-row {
  margin: 16rpx 28rpx 0;
}

.confirm-btn {
  line-height: 2.1 !important;
}

.jog-block {
  margin: 20rpx 28rpx 0;
  padding: 20rpx 20rpx 22rpx;
  border-radius: 22rpx;
  background: #14151f;
  border: 1rpx solid rgba(0, 209, 229, 0.22);
  box-sizing: border-box;
  overflow: hidden;
}

.jog-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.jog-label {
  font-size: 26rpx;
  color: #00d1e5;
  letter-spacing: 2rpx;
  font-weight: 600;
}

.step-pill {
  margin: 0;
  min-width: 0 !important;
  width: auto !important;
  line-height: 1.4;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #f2f4f8;
  background: #1a1b28;
  border: 1rpx solid rgba(0, 209, 229, 0.3);
}

.step-pill::after { border: none; }
.step-pill[disabled] { opacity: 0.4; color: #9aa3b5 !important; }

/* 3×3 网格：左右键不再被 card 裁切（button 默认 min-width 是根因） */
.dpad {
  width: 100%;
  max-width: 360rpx;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 96rpx);
  gap: 12rpx;
  box-sizing: border-box;
}

.dpad-btn {
  width: 100% !important;
  height: 96rpx !important;
  min-width: 0 !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 18rpx;
  background: #1a1b28;
  color: #f2f4f8;
  font-size: 28rpx;
  line-height: 96rpx;
  text-align: center;
  border: 1rpx solid rgba(0, 209, 229, 0.25);
  box-sizing: border-box;
}

.dpad-btn::after {
  border: none;
}

.dpad-btn.spacer {
  background: transparent;
  border: none;
  visibility: hidden;
  pointer-events: none;
}

.dpad-btn.home {
  background: #00d1e5;
  color: #061016;
  border-color: #00d1e5;
  font-size: 26rpx;
  font-weight: 700;
}

.dpad-btn[disabled] {
  opacity: 0.28;
  color: #6b7385;
  border-color: rgba(255, 255, 255, 0.08);
}

.dpad-press {
  opacity: 0.75;
}

.pen-row {
  margin-top: 20rpx;
  display: flex;
  gap: 12rpx;
}

.pen-btn {
  flex: 1;
  min-width: 0;
  margin: 0 !important;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  color: #00d1e5;
  background: #0b0c13;
  border-radius: 14rpx;
  border: 1rpx solid rgba(0, 209, 229, 0.35);
  padding: 0 !important;
}

.pen-btn::after {
  border: none;
}

.pen-btn[disabled] {
  opacity: 0.28;
  color: #6b7385;
  border-color: rgba(255, 255, 255, 0.08);
}

.job-row {
  margin: 20rpx 28rpx 0;
  display: flex;
  gap: 10rpx;
}

.job-btn {
  flex: 1;
  min-width: 0;
  margin: 0 !important;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 2rpx !important;
  font-size: 24rpx;
  color: #c8d0de;
  background: #14151f;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.job-btn::after {
  border: none;
}

.job-btn.danger {
  color: #ff5c6a;
  border-color: rgba(255, 92, 106, 0.4);
}

.job-btn[disabled] {
  opacity: 0.28;
  color: #6b7385;
  border-color: rgba(255, 255, 255, 0.06);
}

.btn-press {
  opacity: 0.85;
}

.tile-press {
  background: #1a1b28 !important;
}

.page-foot {
  padding: 20rpx 0 8rpx;
}

.timeline {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 10rpx;
  margin-top: 16rpx;
}

.timeline-step {
  display: flex;
  align-items: center;
  gap: 6rpx;
  opacity: 0.35;
}

.timeline-step.done {
  opacity: 0.55;
}

.timeline-step.active {
  opacity: 1;
}

.timeline-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #6b7385;
}

.timeline-step.active .timeline-dot {
  background: #00d1e5;
}

.timeline-step.done .timeline-dot {
  background: #3d9aa8;
}

.timeline-lab {
  font-size: 20rpx;
  color: #c5cad6;
}

.timeline-hint,
.eta-row,
.ota-line,
.page-bar-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9aa3b5;
}

.page-bar-wrap {
  margin-top: 12rpx;
}

.page-bar-track {
  margin-top: 6rpx;
  height: 10rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.page-bar-fill {
  height: 100%;
  background: #00d1e5;
  border-radius: 6rpx;
}

.speed-block {
  margin: 24rpx 28rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #14151f;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.speed-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.speed-axis {
  margin-top: 24rpx;
}

.speed-axis-label {
  color: #dce2ed;
  font-size: 25rpx;
}

.speed-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.speed-val {
  font-size: 24rpx;
  color: #00d1e5;
}

.speed-hint {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9aa3b5;
}

.speed-error,
.control-error {
  color: #ffb86b;
  font-size: 24rpx;
  line-height: 1.6;
}

.control-error {
  margin: 20rpx 28rpx;
}

.speed-retry {
  margin-top: 16rpx;
  color: #00d1e5;
  background: #202431;
}
.control-paper-link { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 24rpx; margin-bottom: 18rpx; border: 1rpx solid #25414a; border-radius: 18rpx; background: #10252c; color: #91cec7; font-size: 24rpx; }
.offline-card { margin: 24rpx 28rpx; padding: 32rpx; border-radius: 22rpx; background: #14151f; border: 1rpx solid rgba(255,255,255,.08); }
.offline-title { font-size: 32rpx; font-weight: 600; color: #f2f4f8; }
.offline-sub { margin: 12rpx 0 28rpx; font-size: 25rpx; line-height: 1.6; color: #9aa3b5; }
.connection-step { display: flex; align-items: center; gap: 18rpx; margin-top: 20rpx; color: #cbd3e0; font-size: 26rpx; }
.step-number { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 50%; background: #202431; color: #9ae6e9; flex-shrink: 0; }
.connection-refresh { margin: 32rpx 0 0; min-height: 88rpx; background: rgba(0,209,229,.12); color: #9ae6e9; border-radius: 16rpx; font-size: 28rpx; }
.connection-refresh::after { border-color: rgba(0,209,229,.25); }
.operation-note { margin: 20rpx 28rpx; color: #9ae6e9; font-size: 26rpx; line-height: 1.6; }
