.paper-settings { padding: 32rpx 30rpx calc(44rpx + env(safe-area-inset-bottom)); background: var(--bg); min-height: 100vh; box-sizing: border-box; }
.eyebrow { color: var(--cyan); font-size: 23rpx; letter-spacing: 2rpx; }
.heading { font-size: 46rpx; line-height: 1.35; margin: 16rpx 0 28rpx; font-weight: 600; }
.heading text { margin-left: 18rpx; color: #e4e0d3; }
.paper-scene { display: flex; align-items: center; gap: 40rpx; padding: 30rpx 28rpx; min-height: 250rpx; border-radius: 24rpx; background: var(--panel); }
.sheet { background: #faf9f3; box-shadow: 10rpx 12rpx 0 rgba(0,209,229,.08); box-sizing: border-box; border-radius: 3rpx; padding: 18rpx; flex-shrink: 0; }
.sheet-content { width: 100%; height: 100%; border: 1rpx dashed #c3ccca; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; color: #5d7777; font-size: 24rpx; }
.sheet-line { height: 2rpx; width: 46%; background: #98abaa; transform: rotate(-25deg); }
.sheet-line.short { width: 27%; transform: rotate(20deg); }
.sheet-summary { display: flex; flex-direction: column; gap: 16rpx; color: var(--muted); font-size: 23rpx; line-height: 1.6; }
.summary-title { color: var(--text); font-size: 28rpx; }
.settings-panel { margin-top: 24rpx; padding: 28rpx; border: 1rpx solid var(--line); border-radius: 22rpx; background: var(--panel); }
.section-label { font-size: 27rpx; margin-bottom: 20rpx; }
.presets { display: flex; gap: 12rpx; }
.preset { flex: 1; padding: 0; margin: 0; line-height: 70rpx; font-size: 25rpx; border-radius: 16rpx; color: var(--muted); background: var(--panel-2); }
.preset::after { border-color: var(--line); }
.preset.selected { background: var(--cyan); color: #061016; }
.setting-row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0 6rpx; font-size: 26rpx; }
.dimension-inputs { display: flex; gap: 20rpx; margin-top: 22rpx; }
.dimension-inputs label { flex: 1; min-width: 0; font-size: 23rpx; color: var(--muted); }
.dimension-inputs input, .compact-input { background: var(--panel-2); border: 1rpx solid var(--line); color: var(--text); border-radius: 12rpx; padding: 16rpx; font-size: 29rpx; margin-top: 10rpx; }
.compact-input { width: 100rpx; text-align: right; margin-top: 0; }
.advanced-heading { display: flex; justify-content: space-between; font-size: 27rpx; }
.advanced-arrow { color: var(--cyan); font-size: 24rpx; }
.field-help, .mapping { color: var(--muted); font-size: 23rpx; line-height: 1.65; margin-top: 18rpx; }
.device-note { margin: 24rpx 4rpx 0; color: #c4c9d3; font-size: 25rpx; line-height: 1.6; }
.device-note button, .settings-state button { color: var(--cyan); background: var(--panel-2); font-size: 24rpx; margin-top: 12rpx; }
.fit-error { color: #ffb84d; font-size: 25rpx; line-height: 1.6; padding: 24rpx 4rpx 0; }
.save-button { background: var(--cyan); color: #061016; font-size: 30rpx; line-height: 86rpx; border-radius: 44rpx; margin-top: 30rpx; }
button[disabled] { opacity: .5; }
.save-hint, .settings-state { color: var(--muted); font-size: 24rpx; text-align: center; padding: 24rpx 8rpx; line-height: 1.65; }
