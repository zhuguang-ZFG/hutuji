<view class="paper-settings">
  <view class="settings-heading"><text class="eyebrow">创作，从一张纸开始</text><view class="heading">选好纸张<text>留足想象</text></view></view>
  <view class="settings-state" wx:if="{{loading}}">正在读取设备设置…</view>
  <view class="settings-state" wx:if="{{loadError}}"><text>{{loadError}}</text><button bindtap="onRetry">重新读取</button><button wx:if="{{!deviceMac}}" bindtap="onBind">扫码连接写字机</button></view>
  <block wx:if="{{form}}">
    <view class="paper-scene">
      <view class="sheet" style="width:{{paperWidth}}rpx;height:{{paperHeight}}rpx"><view class="sheet-content"><view class="sheet-line"></view><view class="sheet-line short"></view><text>{{form.paper === 'custom' ? '自定义' : form.paper}}</text></view></view>
      <view class="sheet-summary"><text class="summary-title">{{form.width_mm}} × {{form.height_mm}} 毫米</text><text wx:if="{{dimensions}}">创作区 {{dimensions.pageWidth}} × {{dimensions.pageHeight}} 毫米</text><text>{{form.landscape ? '横版' : '竖版'}} · 四周留边 {{form.margin_mm}} 毫米</text></view>
    </view>
    <view class="device-note" wx:if="{{!capable}}">当前固件暂不支持修改纸张。升级后，可在这里设置并同步到设备。<button size="mini" bindtap="onFirmware">查看固件</button></view>
    <view class="device-note" wx:elif="{{!online}}">设备未连接，当前为上次读取的设置。连接后可修改。<button size="mini" bindtap="onRetry">重新连接</button></view>
    <view class="settings-panel">
      <view class="section-label">纸张大小</view>
      <view class="presets"><button wx:for="{{presets}}" wx:key="*this" class="preset {{form.paper === item ? 'selected' : ''}}" data-paper="{{item}}" bindtap="onPreset" disabled="{{!capable || !online || saving}}">{{item === 'custom' ? '自定义' : item}}</button></view>
      <view class="dimension-inputs" wx:if="{{form.paper === 'custom'}}">
        <label><text>纸宽 / 毫米</text><input type="digit" value="{{form.width_mm}}" data-field="width_mm" bindinput="onInput" disabled="{{!capable || !online || saving}}" /></label>
        <label><text>纸高 / 毫米</text><input type="digit" value="{{form.height_mm}}" data-field="height_mm" bindinput="onInput" disabled="{{!capable || !online || saving}}" /></label>
      </view>
      <view class="setting-row"><text>横向创作</text><switch checked="{{form.landscape}}" data-field="landscape" bindchange="onToggle" disabled="{{!capable || !online || saving}}" color="#00d1e5" /></view>
      <view class="setting-row"><text>四周留边 / 毫米</text><input class="compact-input" type="digit" value="{{form.margin_mm}}" data-field="margin_mm" bindinput="onInput" disabled="{{!capable || !online || saving}}" /></view>
    </view>
    <view class="settings-panel">
      <view class="advanced-heading" bindtap="onAdvanced"><text>机器范围与轴向</text><text class="advanced-arrow">{{advanced ? '收起' : '展开'}}</text></view>
      <block wx:if="{{advanced}}">
        <view class="setting-row"><text>交换 X / Y 轴</text><switch checked="{{form.swap_xy}}" data-field="swap_xy" bindchange="onToggle" disabled="{{!capable || !online || saving}}" color="#00d1e5" /></view>
        <view class="field-help">按机器安装方向设置。纸张大小与机器行程分别保存，选择大纸不会自动扩大机器范围。</view>
        <view class="dimension-inputs">
          <label><text>X 可绘制 / 毫米</text><input type="digit" value="{{form.max_x_mm}}" data-field="max_x_mm" bindinput="onInput" disabled="{{!capable || !online || saving}}" /></label>
          <label><text>Y 可绘制 / 毫米</text><input type="digit" value="{{form.max_y_mm}}" data-field="max_y_mm" bindinput="onInput" disabled="{{!capable || !online || saving}}" /></label>
        </view>
      </block>
      <view class="mapping" wx:if="{{dimensions}}">本页使用 X {{dimensions.x}} × Y {{dimensions.y}} 毫米</view>
    </view>
    <view class="fit-error" wx:if="{{fitError}}">{{fitError}}</view>
    <view class="save-hint" wx:if="{{dirty}}">有未保存的修改</view>
    <button class="save-button" bindtap="onSave" disabled="{{!dirty || !capable || !online || loading || saving || !!fitError}}">{{saving ? '正在保存并核对…' : (dirty ? '保存到当前设备' : '已与设备设置一致')}}</button>
    <button wx:if="{{dirty}}" class="reset-button" bindtap="onResetForm" disabled="{{loading || saving || !online}}">还原修改</button>
    <view class="save-hint">{{hint || '设置用于之后生成的图画、文字、笔顺与手绘'}}</view>
  </block>
</view>
