@import "../../styles/weui-page.wxss";

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: 0;
  box-sizing: border-box;
}

.msg-scroll {
  flex: 1;
  min-height: 0;
  padding: 24rpx 28rpx 12rpx;
  box-sizing: border-box;
}

.msg-list {
  display: flex;
  flex-direction: column;
  padding-bottom: 16rpx;
}

.msg-row {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
  max-width: 82%;
}

.msg-row.user {
  align-self: flex-end;
  margin-left: auto;
  align-items: flex-end;
}

.msg-row.assistant {
  align-self: flex-start;
  margin-right: auto;
  align-items: flex-start;
}

.bubble {
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.55;
  word-break: break-word;
}

.msg-row.user .bubble {
  background: rgba(0, 209, 229, 0.18);
  color: #e8fbff;
  border: 1rpx solid rgba(0, 209, 229, 0.35);
  border-bottom-right-radius: 6rpx;
}

.msg-row.assistant .bubble {
  background: #14151f;
  color: #f2f4f8;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-bottom-left-radius: 6rpx;
}

.tool-traces {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.45;
  white-space: pre-wrap;
  max-width: 100%;
}

.preview-card {
  margin-top: 12rpx;
  padding: 12rpx;
  border-radius: 16rpx;
  background: #10121a;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  width: 100%;
  box-sizing: border-box;
}

.preview-img {
  width: 100%;
  height: 280rpx;
  background: #0a0b10;
  border-radius: 10rpx;
}

.preview-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.btn-confirm,
.btn-cancel {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.btn-confirm {
  background: #00d1e5;
  color: #061016;
}

.btn-confirm.ghost {
  background: transparent;
  color: #00d1e5;
  border: 1rpx solid rgba(0, 209, 229, 0.45);
}

.btn-confirm.disabled {
  opacity: 0.45;
  pointer-events: none;
}

.btn-cancel {
  background: transparent;
  color: #c5cad6;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.preview-done {
  margin-top: 10rpx;
  font-size: 22rpx;
}

/* 文字链画图卡 */
.draw-card {
  margin-top: 12rpx;
  padding: 12rpx;
  border-radius: 16rpx;
  background: #10121a;
  border: 1rpx solid rgba(0, 209, 229, 0.22);
  width: 100%;
  box-sizing: border-box;
}

.draw-desc {
  font-size: 26rpx;
  color: #f2f4f8;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.draw-state {
  font-size: 24rpx;
  color: #9aa3b5;
  text-align: center;
  padding: 12rpx 0;
}

.draw-state.warn {
  color: #ffb84d;
}

.draw-btn {
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: #00d1e5;
  color: #061016;
}

.draw-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.btn-press {
  opacity: 0.82;
}

/* 打字输入行（按住说话之上） */
.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 28rpx 0;
  background: #0b0c13;
}

/* 设置入口（音色/模型 → 小派设置页） */
.gear {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 34rpx;
  color: #9aa3b5;
  background: #1a1b28;
  border-radius: 999rpx;
}

.text-input {
  flex: 1;
  background: #1a1b28;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  font-size: 28rpx;
  color: #f2f4f8;
}

.ph {
  color: #6b7385;
}

.text-send {
  flex-shrink: 0;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #061016;
  background: #00d1e5;
  border-radius: 999rpx;
}

.text-send.disabled {
  opacity: 0.45;
  pointer-events: none;
}

.hold-area {
  padding: 16rpx 28rpx 8rpx;
  background: #0b0c13;
}

.hold-btn {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #061016;
  background: #00d1e5;
  border: 1rpx solid #00d1e5;
  user-select: none;
}

.hold-btn.active {
  background: #00a8bc;
  border-color: #00a8bc;
  transform: scale(0.98);
}

.hold-btn.disabled {
  opacity: 0.45;
  pointer-events: none;
}

.page-foot {
  padding: 12rpx 0 16rpx;
  text-align: center;
}
