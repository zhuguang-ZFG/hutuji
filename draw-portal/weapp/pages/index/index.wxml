<view class="page">
  <view class="card">
    <view class="title">画点什么</view>
    <textarea
      class="desc-input"
      placeholder="描述要画的内容，例如：一只简笔画小猫"
      value="{{description}}"
      bindinput="onDescInput"
      maxlength="200"
      auto-height
    />
    <view class="quota" wx:if="{{quotaLeft !== null}}">
      今日剩余生图 {{quotaLeft}} 次
    </view>
    <button
      class="btn primary"
      bindtap="onGenerate"
      loading="{{generating}}"
      disabled="{{generating || !description}}"
    >
      {{generating ? "生成中（约 10-60 秒）…" : "生成图画"}}
    </button>
  </view>

  <view class="card" wx:if="{{job}}">
    <view class="title">预览</view>
    <image
      class="preview"
      src="{{job.previewUrl}}"
      mode="aspectFit"
      bindtap="onPreviewTap"
    />
    <view class="meta">约 {{job.lines}} 行笔画</view>
    <button
      class="btn primary"
      bindtap="onSend"
      loading="{{sending}}"
      disabled="{{sending}}"
    >
      发送到写字机
    </button>
  </view>

  <view class="card" wx:if="{{binding === null}}">
    <view class="title">绑定写字机</view>
    <view class="meta">还没有绑定设备</view>
    <button class="btn" bindtap="onGoBind">去绑定</button>
  </view>
  <view class="card" wx:if="{{binding}}">
    <view class="title">已绑定设备</view>
    <view class="meta">设备尾号 {{binding.macSuffix}}</view>
  </view>

  <view class="card">
    <view class="title">上传文档/图片</view>
    <button class="btn" bindtap="onPickFile">选择文件（图片/Word/Excel/PPT/PDF）</button>
    <view class="meta" wx:if="{{uploading}}">转换中…</view>
    <view class="meta" wx:if="{{uploadJob}}">就绪：{{uploadJob.sourceName}}</view>
    <button
      wx:if="{{uploadJob}}"
      class="btn primary"
      bindtap="onSendUpload"
      loading="{{sending}}"
      disabled="{{sending}}"
    >
      发送到写字机
    </button>
  </view>
</view>
