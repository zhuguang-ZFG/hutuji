<view class="page create-page">
  <view class="atelier-head">
    <text class="atelier-kicker">XIAOPAI'S DOODLE CLUB</text>
    <text class="atelier-title">小派陪你，把灵感画出来</text>
    <text class="atelier-copy">画画、写字、照片变线稿，今天也要可可爱爱地创作。</text>
    <view class="atelier-line"></view>
    <view class="pai-mascot" aria-label="小派">
      <view class="pai-ear pai-ear-left"></view><view class="pai-ear pai-ear-right"></view>
      <view class="pai-face"><view class="pai-eye"></view><view class="pai-eye"></view><view class="pai-blush pai-blush-left"></view><view class="pai-blush pai-blush-right"></view><view class="pai-mouth"></view></view>
      <text class="pai-star">✦</text>
    </view>
  </view>
  <view class="mode-segment">
    <view
      class="mode-tab {{mode === 'draw' ? 'active' : ''}}"
      data-mode="draw"
      bindtap="onModeTap"
    >画图</view>
    <view
      class="mode-tab {{mode === 'write' ? 'active' : ''}}"
      data-mode="write"
      bindtap="onModeTap"
    >写字</view>
    <view
      class="mode-tab {{mode === 'teach' ? 'active' : ''}}"
      data-mode="teach"
      bindtap="onModeTap"
    >笔顺</view>
  </view>

  <view class="slim-head">
    <text class="slim-title" wx:if="{{mode === 'draw'}}">想画点<text class="accent">什么</text></text>
    <text class="slim-title" wx:elif="{{mode === 'write'}}">想写点<text class="accent">什么</text></text>
    <text class="slim-title" wx:else>想学点<text class="accent">什么</text></text>
    <text class="slim-quota" wx:if="{{quotaLeft !== null}}">今日 {{quotaLeft}} 次</text>
  </view>
  <navigator class="paper-summary {{paperSummary.state}}" url="/pages/paper/paper" hover-class="btn-press" aria-label="当前设备纸张与方向">
    <view class="paper-summary-sheet {{paperSummary.landscape ? 'landscape' : ''}}" aria-hidden="true"></view>
    <view class="paper-summary-copy"><view class="paper-summary-title">{{paperSummary.title}}</view><view class="paper-summary-detail">{{paperSummary.detail}}</view><view wx:if="{{paperSummary.hint}}" class="paper-summary-hint">{{paperSummary.hint}}</view></view>
    <text class="paper-summary-arrow">›</text>
  </navigator>

  <!-- 画图模式 -->
  <block wx:if="{{mode === 'draw'}}">
    <view class="weui-cells input-panel">
      <view class="weui-cell weui-cell_textarea">
        <view class="weui-cell__bd">
          <textarea
            class="weui-textarea"
            placeholder="一句话，例如：一只简笔画小猫"
            value="{{description}}"
            bindinput="onDescInput"
            maxlength="200"
            auto-height
            placeholder-class="ph"
          />
        </view>
      </view>
    </view>
    <view class="input-caption"><text>描述主体、动作和风格，轮廓越清楚越好</text><text>{{description.length}}/200</text></view>
    <view class="example-row"><text>试着画</text><button size="mini" bindtap="onExample" data-text="坐着的小猫，简洁清楚的线条">小猫</button><button size="mini" bindtap="onExample" data-text="一枝兰花，简洁线描">兰花</button><button size="mini" bindtap="onExample" data-text="月亮下的小房子，儿童简笔画">小房子</button></view>
    <view class="weui-btn-area tight">
      <button
        class="weui-btn weui-btn_primary"
        hover-class="btn-press"
        bindtap="onGenerate"
        loading="{{generating}}"
        disabled="{{generating || uploading || !description}}"
      >
        {{generating ? "生成中…" : "生成图画"}}
      </button>
    </view>
  </block>

  <!-- 写字模式：手输 / AI 写文 / 润色 → 再排版预览（§10.4.12） -->
  <block wx:elif="{{mode === 'write'}}">
    <view class="weui-cells input-panel">
      <view class="weui-cell weui-cell_textarea">
        <view class="weui-cell__bd">
          <textarea
            class="weui-textarea write-area"
            placeholder="写主题（如：春天）或贴草稿；最多 5000 字"
            value="{{writeText}}"
            bindinput="onWriteInput"
            maxlength="5000"
            auto-height
            placeholder-class="ph"
          />
        </view>
      </view>
    </view>

    <view class="input-caption"><text>先写文字或主题，再预览排版</text><text>{{writeText.length}}/5000</text></view>
    <view class="ai-row">
      <button
        class="weui-btn weui-btn_default ai-btn"
        hover-class="btn-press"
        bindtap="onAiGenerate"
        loading="{{aiWriting}}"
        disabled="{{aiWriting || layouting || !writeText}}"
      >AI写一篇</button>
      <button
        class="weui-btn weui-btn_default ai-btn"
        hover-class="btn-press"
        bindtap="onAiPolish"
        loading="{{aiWriting}}"
        disabled="{{aiWriting || layouting || !writeText}}"
      >润色扩写</button>
    </view>

    <view class="draft-notice" wx:if="{{aiSuggestion}}"><text>AI 新稿已备好，你正在编辑的文字已保留。</text><button size="mini" bindtap="onApplyAiSuggestion" disabled="{{aiWriting || layouting}}">采用AI新稿</button></view>
    <view class="draft-actions" wx:if="{{canUndoAiText}}"><button size="mini" bindtap="onUndoAiText" disabled="{{aiWriting || layouting}}">恢复AI处理前原稿</button></view>

    <view class="layout-controls">
      <view class="layout-row" wx:if="{{fonts.length}}">
        <text class="layout-label">字体</text>
        <picker
          class="font-picker"
          range="{{fontNames}}"
          value="{{fontIndex}}"
          bindchange="onFontChange"
        >
          <view class="font-picker-val">{{fontNames[fontIndex]}} ▾</view>
        </picker>
      </view>
      <view class="layout-row">
        <text class="layout-label">字号</text>
        <view class="stepper">
          <view class="step-btn" hover-class="btn-press" bindtap="bumpSize" data-delta="-1">−</view>
          <text class="step-val">{{sizeMm}} mm</text>
          <view class="step-btn" hover-class="btn-press" bindtap="bumpSize" data-delta="1">+</view>
        </view>
      </view>
      <view class="layout-row">
        <text class="layout-label">行距</text>
        <view class="stepper">
          <view class="step-btn" hover-class="btn-press" bindtap="bumpLine" data-delta="-0.1">−</view>
          <text class="step-val">{{lineSpacing}}×</text>
          <view class="step-btn" hover-class="btn-press" bindtap="bumpLine" data-delta="0.1">+</view>
        </view>
      </view>
    </view>

    <view class="weui-btn-area tight">
      <button
        class="weui-btn weui-btn_primary"
        hover-class="btn-press"
        bindtap="onLayoutPreview"
        loading="{{layouting}}"
        disabled="{{layouting || aiWriting || !writeText}}"
      >
        {{layouting ? "排版中…" : "排版预览"}}
      </button>
    </view>
  </block>

  <!-- 笔顺模式 -->
  <block wx:elif="{{mode === 'teach'}}">
    <view class="weui-cells input-panel">
      <view class="weui-cell weui-cell_textarea">
        <view class="weui-cell__bd">
          <textarea
            class="weui-textarea write-area"
            placeholder="随便写，例如：春眠不觉晓"
            value="{{teachText}}"
            bindinput="onTeachInput"
            maxlength="200"
            auto-height
            placeholder-class="ph"
          />
        </view>
      </view>
    </view>
    <view class="input-caption"><text>按汉字逐笔展示，可输入词语或短句</text><text>{{teachText.length}}/200</text></view>
    <view class="example-row"><text>试着写</text><button size="mini" bindtap="onExample" data-text="春眠不觉晓">古诗</button><button size="mini" bindtap="onExample" data-text="好好学习">词语</button></view>
    <view class="weui-btn-area tight">
      <button
        class="weui-btn weui-btn_primary"
        hover-class="btn-press"
        bindtap="onTeachGenerate"
        loading="{{teaching}}"
        disabled="{{teaching || !teachText}}"
      >
        {{teaching ? "生成中…" : "生成笔顺"}}
      </button>
    </view>
  </block>

  <!-- 共用预览卡 -->
  <view class="draft-notice" wx:if="{{generating || aiWriting || layouting || teaching}}">{{aiWriting ? '正在整理文字' : layouting ? '正在排版并生成预览' : teaching ? '正在生成笔顺' : '正在生成图画'}}… 可先查看控制或历史页面，返回创作后查看结果，请勿重复提交。</view>
  <block wx:if="{{job}}">
    <view class="preview-card">
      <view class="result-head"><text class="result-title">{{job.refining ? '正在创作' : '作品预览'}}</text><text class="result-badge">{{job.refining ? '请稍候' : '先预览 · 再发送'}}</text></view>
      <view class="refine-waiting" wx:if="{{job.refining}}">
        <view class="pulse-ring"></view>
        <view class="refine-waiting-title">AI 正在画</view>
        <view class="muted center-text" wx:if="{{!job.refineOffline}}">约 10 秒～2 分钟，好了自动上屏</view>
        <block wx:else>
          <view class="muted center-text">网络不稳定，暂未取到精修结果，仍在继续等待</view>
          <view class="draft-actions center-actions"><button size="mini" bindtap="onRecheckRefined" loading="{{job.refineChecking}}" disabled="{{job.refineChecking}}">重新核对</button></view>
        </block>
      </view>
      <block wx:else>
        <view class="page-nav" wx:if="{{job.pages && job.pages.length > 1}}">
          <button
            class="page-nav-btn"
            size="mini"
            aria-label="上一页"
            hover-class="btn-press"
            bindtap="onPrevPage"
            disabled="{{pageIndex <= 0}}"
          >‹</button>
          <text class="page-nav-label">第 {{pageIndex + 1}} / {{job.pageCount || job.pages.length}} 页</text>
          <button
            class="page-nav-btn"
            size="mini"
            aria-label="下一页"
            hover-class="btn-press"
            bindtap="onNextPage"
            disabled="{{pageIndex >= job.pages.length - 1}}"
          >›</button>
        </view>
        <view class="version-switch" wx:if="{{job.refined}}">
          <button size="mini" class="{{!job.useRefined ? 'selected' : ''}}" bindtap="onSelectVersion" data-version="original" disabled="{{sending || saving}}">快速草图</button>
          <button size="mini" class="{{job.useRefined ? 'selected' : ''}}" bindtap="onSelectVersion" data-version="refined" disabled="{{sending || saving}}">AI 精修</button>
        </view>
        <image
          class="preview"
          src="{{job.pages && job.pages.length ? job.pages[pageIndex].preview_url : (job.useRefined && job.refined ? job.refined.previewUrl : job.previewUrl)}}"
          mode="aspectFit"
          bindtap="onPreviewTap"
        />
        <view class="preview-meta muted" wx:if="{{mode === 'draw' || job.refined || (mode === 'write' && aiTextUsed)}}">内容由 AI 生成，仅供参考</view>
        <view class="preview-meta muted" wx:if="{{job.inputTruncated}}">仅保留前 20 个汉字</view>
        <view class="preview-meta muted" wx:if="{{job.truncated}}">超过 20 页上限，已截断</view>
        <view class="preview-meta muted" wx:if="{{job.missingCharsText}}">缺字 {{job.missingCharsText}}（写出为空白）</view>
        <view class="preview-meta muted" wx:if="{{job.refined}}">{{job.useRefined ? 'AI 精修' : '快速草图'}} · 收藏、分享和发送使用当前版本</view>
        <view class="preview-meta muted" wx:elif="{{job.refineFailed === 'failed'}}">精修未成功 · 快速草图</view>
        <view class="preview-meta muted" wx:elif="{{job.refineFailed === 'timeout'}}">精修结果暂未确认 · 先看草图</view>
        <view class="preview-meta muted" wx:elif="{{job.pages && job.pages.length > 1}}">共 {{job.pageCount || job.pages.length}} 页 · 点图放大</view>
        <view class="preview-meta muted" wx:elif="{{mode === 'teach' && job.charsTaught}}">教 {{job.charsTaught.length}} 字 · 点图放大</view>
        <view class="preview-meta muted" wx:else>约 {{job.lines}} 行 · 点图放大</view>
        <view class="draft-actions" wx:if="{{job.photoSource || job.refineFailed === 'timeout'}}">
          <button size="mini" wx:if="{{job.photoSource}}" bindtap="onComparePhoto">对照原图</button>
          <button size="mini" wx:if="{{job.refineFailed === 'timeout'}}" bindtap="onRetryRefined" loading="{{job.refineChecking}}" disabled="{{job.refineChecking}}">查看精修结果</button>
        </view>
        <view class="preview-actions">
          <button
            class="weui-btn weui-btn_default action-inline"
            hover-class="btn-press"
            bindtap="onSave"
            loading="{{saving}}"
            disabled="{{saving || sending || generating || uploading || layouting || teaching || aiWriting}}"
          >收藏</button>
          <button
            wx:if="{{shareToken}}"
            class="weui-btn weui-btn_default action-inline"
            hover-class="btn-press"
            open-type="share"
          >分享</button>
          <button wx:else class="weui-btn weui-btn_default action-inline" bindtap="onRetryShare"
            loading="{{shareLoading}}" disabled="{{shareLoading}}">{{shareLoading ? '准备分享' : '重试分享'}}</button>
          <button
            class="weui-btn weui-btn_primary action-inline send-primary"
            hover-class="btn-press"
            bindtap="onSend"
            loading="{{sending}}"
            disabled="{{sending || saving || generating || uploading || layouting || teaching || aiWriting}}"
          >{{sending ? '正在发送…' : '发送到丹青'}}</button>
        </view>
        <view wx:if="{{shareError}}" class="share-feedback">{{shareError}}</view>
      </block>
    </view>
  </block>

  <!-- 画图：三格入口 -->
  <view class="action-grid" wx:if="{{mode === 'draw'}}">
    <button class="action-tile" hover-class="tile-press" bindtap="onTakePhoto" data-source="camera" disabled="{{uploading}}">
      <view class="tile-icon cam"></view>
      <text class="tile-label">拍照</text>
    </button>
    <button class="action-tile" hover-class="tile-press" bindtap="onTakePhoto" data-source="album" disabled="{{uploading}}">
      <view class="tile-icon album"></view>
      <text class="tile-label">相册</text>
    </button>
    <button class="action-tile" hover-class="tile-press" bindtap="onPickFile" disabled="{{uploading}}">
      <view class="tile-icon doc"></view>
      <text class="tile-label">{{uploading ? "转换中" : "文档"}}</text>
    </button>
    <button class="action-tile" hover-class="tile-press" bindtap="onDrawPad" disabled="{{uploading}}">
      <view class="tile-icon pad"></view>
      <text class="tile-label">手绘</text>
    </button>
  </view>

  <!-- 写字：仅文档 -->
  <view class="action-grid action-grid-single" wx:elif="{{mode === 'write'}}">
    <button class="action-tile" hover-class="tile-press" bindtap="onPickFile" disabled="{{uploading}}">
      <view class="tile-icon doc"></view>
      <text class="tile-label">{{uploading ? "转换中" : "文档"}}</text>
    </button>
  </view>
  <view class="weui-cells__tips" wx:if="{{uploading}}">正在转换并生成预览，内容较多时需要更久，请勿重复上传。</view>
  <view class="weui-cells__tips" wx:elif="{{mode === 'draw'}}">照片建议光线均匀、主体清晰、背景简洁。可对比快速草图与精修版后再发送。</view>
  <view class="weui-cells__tips" wx:if="{{mode !== 'teach'}}">文档支持 Word、Excel、PPT、CSV、TXT 和 SVG，单文件不超过 4MB。</view>

  <view class="bind-banner market-banner" bindtap="onGoMarket" hover-class="tile-press">
    <view class="bind-copy">
      <text class="bind-title">精品图库</text>
      <text class="bind-sub">现成好图，一键发送给丹青</text>
    </view>
    <text class="bind-go">去挑选 ›</text>
  </view>

  <view class="bind-banner" wx:if="{{!binding}}" bindtap="onGoBind" hover-class="tile-press">
    <view class="bind-copy">
      <text class="bind-title">还没绑定丹青</text>
      <text class="bind-sub">扫码或输码，约 10 秒</text>
    </view>
    <text class="bind-go">去绑定 ›</text>
  </view>
</view>
