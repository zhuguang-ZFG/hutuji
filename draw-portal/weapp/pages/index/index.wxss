.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.hero {
  background: linear-gradient(135deg, #1A1A2E 0%, #24344F 100%);
  color: #fff;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.desc-input {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 20rpx;
  min-height: 120rpx;
  color: #fff;
  font-size: 28rpx;
}

.desc-input::placeholder {
  color: rgba(255, 255, 255, 0.45);
}

.hero-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.hero-btn {
  min-width: 300rpx;
}

.preview {
  width: 100%;
  height: 560rpx;
  background: #F6F1E6;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.center-text {
  text-align: center;
  margin-bottom: 16rpx;
}

.block-btn {
  margin-top: 16rpx;
}

.row-btns {
  display: flex;
  gap: 20rpx;
}

.half {
  flex: 1;
}

/* AI 精修版本切换：线稿版 / 精修版两张小卡横排，选中项加主题色高亮边框 */
.version-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.version-item {
  flex: 1;
  padding: 10rpx;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  text-align: center;
}

.version-active {
  border-color: var(--primary);
}

.version-thumb {
  width: 100%;
  height: 180rpx;
  background: #F6F1E6;
  border-radius: 12rpx;
}

.version-name {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8A8A99;
}

.upload-ready {
  margin-top: 20rpx;
}

.bind-card {
  border: 2rpx dashed #2E6E65;
}
