.page {
  padding: 24rpx;
  background: #F6F1E6;
  min-height: 100vh;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A1A2E;
  margin-bottom: 16rpx;
}
.meta {
  font-size: 26rpx;
  color: #888;
  margin: 12rpx 0;
}
.desc-input {
  width: 100%;
  min-height: 120rpx;
  background: #F6F1E6;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 12rpx;
}
.quota {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}
.preview {
  width: 100%;
  height: 640rpx;
  background: #F6F1E6;
  border-radius: 12rpx;
}
.btn {
  margin-top: 16rpx;
  background: #E8E4DA;
  color: #1A1A2E;
  border-radius: 16rpx;
  font-size: 30rpx;
}
.btn.primary {
  background: #2E6E65;
  color: #fff;
}
