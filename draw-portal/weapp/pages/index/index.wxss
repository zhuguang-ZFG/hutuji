@import "../../styles/weui-page.wxss";

.input-caption { display: flex; justify-content: space-between; gap: 20rpx; margin: 12rpx 32rpx; color: #9aa3b5; font-size: 23rpx; }
.input-caption text:last-child { flex-shrink: 0; }
.example-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin: 20rpx 32rpx; color: #9aa3b5; font-size: 24rpx; }
.example-row button, .draft-actions button { margin: 0; background: #171b29; color: #9ae6e9; border-radius: 999rpx; font-size: 24rpx; }
.draft-notice { margin: 22rpx 28rpx; padding: 22rpx 24rpx; border-radius: 16rpx; background: rgba(0,209,229,0.08); color: #b4e8ea; font-size: 26rpx; line-height: 1.7; }
.draft-notice button { margin: 14rpx 0 0; color: #061016; background: #00d1e5; }
.draft-actions { display: flex; flex-wrap: wrap; gap: 14rpx; margin: 16rpx 32rpx; }
.draft-actions.center-actions { justify-content: center; margin-top: 20rpx; }
.draft-actions button { padding: 14rpx 24rpx; min-height: 88rpx; line-height: 1.7; font-size: 26rpx; display: flex; align-items: center; justify-content: center; }
.version-switch { display: flex; gap: 14rpx; justify-content: center; padding: 20rpx; }
.version-switch button { margin: 0; background: #171b29; color: #9aa3b5; border-radius: 999rpx; }
.version-switch .selected { color: #061016; background: #00d1e5; }
@import "../../styles/paper-summary.wxss";

.create-page {
  padding-bottom: 32rpx;
}

.mode-segment {
  margin: 16rpx 28rpx 0;
  display: flex;
  background: #14151f;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  padding: 6rpx;
  gap: 6rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #9aa3b5;
  border-radius: 12rpx;
  transition: background 0.15s;
}

.mode-tab.active {
  background: rgba(0, 209, 229, 0.15);
  color: #00d1e5;
}

.slim-head {
  margin: 20rpx 28rpx 12rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.slim-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.slim-title .accent {
  color: #00d1e5;
}

.slim-quota {
  font-size: 22rpx;
  color: #9aa3b5;
  flex-shrink: 0;
}

.input-panel {
  margin-top: 0;
}

.weui-cell_textarea {
  align-items: flex-start;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
}

.weui-textarea {
  width: 100%;
  min-height: 100rpx;
  font-size: 30rpx;
  color: #f2f4f8;
  line-height: 1.5;
}

.ph {
  color: #6b7385;
}

.write-area {
  min-height: 200rpx;
}

.layout-controls {
  margin: 0 24rpx;
  padding: 20rpx 24rpx;
  background: #14151f;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.layout-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.layout-label {
  font-size: 28rpx;
  color: #4d3a46;
  font-weight: 500;
  flex-shrink: 0;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #b03f5a;
  background: #fdefe4;
  border: 1rpx solid rgba(216, 95, 123, 0.35);
  border-radius: 12rpx;
}

.step-btn::after {
  border: none;
}

.step-val {
  font-size: 28rpx;
  color: #4d3a46;
  min-width: 120rpx;
  text-align: center;
}

.page-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.page-nav .page-nav-btn {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  line-height: 84rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #b03f5a;
  background: #fdefe4;
  border: 1rpx solid rgba(216, 95, 123, 0.35);
  border-radius: 12rpx;
}

.page-nav-btn::after {
  border: none;
}

.page-nav-btn[disabled] {
  opacity: 0.35;
}

.page-nav-label {
  white-space: nowrap;
  font-size: 28rpx;
  color: #4d3a46;
  font-weight: 500;
}

.preview-card {
  margin: 20rpx 24rpx 0;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #14151f;
  border: 1rpx solid rgba(0, 209, 229, 0.22);
}

.preview {
  width: 100%;
  height: 620rpx;
  background: #0b0c13;
  border-radius: 16rpx;
  display: block;
}

.preview-meta {
  text-align: center;
  margin: 14rpx 0 8rpx;
}

.preview-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.action-inline {
  flex: 1 1 40%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  line-height: 2.1 !important;
  font-size: 28rpx !important;
}
.preview-actions .send-primary { flex-basis: 100%; }
.result-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 4rpx 4rpx 22rpx; }
.result-title { font-size: 30rpx; font-weight: 600; color: #f2f4f8; }
.result-badge { font-size: 22rpx; color: #9ae6e9; background: rgba(0,209,229,.08); border-radius: 999rpx; padding: 8rpx 16rpx; }
.share-feedback { color: #f0ba78; font-size: 24rpx; line-height: 1.6; padding: 16rpx 8rpx 0; }


.refine-waiting {
  padding: 64rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.pulse-ring {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(0, 209, 229, 0.25);
  box-shadow: 0 0 0 12rpx rgba(0, 209, 229, 0.08), inset 0 0 0 18rpx rgba(0, 209, 229, 0.35);
}

.refine-waiting-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #00d1e5;
}

.center-text {
  text-align: center;
}

.action-grid-single {
  justify-content: center;
}

.action-grid-single .action-tile {
  max-width: 240rpx;
}

.action-grid {
  margin: 28rpx 24rpx 0;
  display: flex;
  gap: 16rpx;
}

.action-tile {
  flex: 1;
  margin: 0;
  padding: 28rpx 8rpx 24rpx;
  background: #14151f;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  line-height: 1.2;
}

.action-tile::after {
  border: none;
}

.action-tile[disabled] {
  opacity: 0.45;
}

.tile-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 3rpx solid #00d1e5;
  box-sizing: border-box;
  position: relative;
}

.tile-icon.cam {
  border-radius: 14rpx;
}
.tile-icon.cam::after {
  content: "";
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 3rpx solid #00d1e5;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

.tile-icon.album {
  border-style: dashed;
}

.tile-icon.doc {
  border-radius: 6rpx 14rpx 6rpx 6rpx;
}

.tile-icon.pad::after {
  content: "";
  position: absolute;
  width: 22rpx;
  height: 3rpx;
  background: #00d1e5;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%) rotate(-45deg);
}

.tile-label {
  font-size: 24rpx;
  color: #f2f4f8;
  font-weight: 500;
}

.bind-banner {
  margin: 28rpx 24rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(0, 209, 229, 0.08);
  border: 1rpx solid rgba(0, 209, 229, 0.28);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

/* 精品图库入口：绿色主调，与绑定横幅区分，孩子一眼认出「能直接画」 */
.market-banner {
  background: rgba(7, 193, 96, 0.08);
  border-color: rgba(7, 193, 96, 0.3);
}

.bind-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.bind-title {
  font-size: 28rpx;
  color: #f2f4f8;
  font-weight: 600;
}

.bind-sub {
  font-size: 22rpx;
  color: #735f69;
}

.bind-go {
  font-size: 26rpx;
  color: #00d1e5;
  font-weight: 600;
  flex-shrink: 0;
}

.btn-press {
  opacity: 0.82;
}

.tile-press {
  background: #fdefe4 !important;
  border-color: rgba(216, 95, 123, 0.35) !important;
}

.ai-row {
  display: flex;
  gap: 16rpx;
  margin: 8rpx 24rpx 0;
  padding: 0;
}
.ai-btn {
  flex: 1;
  margin-top: 0 !important;
  margin-bottom: 0 !important;
}

/* 字体选择器（§10.4.12）：与 stepper 同行布局，值域右对齐胶囊 */
.font-picker {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}
.font-picker-val {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(11, 12, 19, 0.72);
  color: #e8e9f0;
  font-size: 26rpx;
  max-width: 420rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
