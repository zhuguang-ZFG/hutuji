.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.hero {
  background: linear-gradient(135deg, #1A1A2E 0%, #24344F 100%);
  color: #fff;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.desc-input {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 20rpx;
  min-height: 120rpx;
  color: #fff;
  font-size: 28rpx;
}

.desc-input::placeholder {
  color: rgba(255, 255, 255, 0.45);
}

.hero-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.hero-btn {
  min-width: 300rpx;
}

.preview {
  width: 100%;
  height: 560rpx;
  background: #F6F1E6;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.center-text {
  text-align: center;
  margin-bottom: 16rpx;
}

.block-btn {
  margin-top: 16rpx;
}

.row-btns {
  display: flex;
  gap: 20rpx;
}

.half {
  flex: 1;
}

.upload-ready {
  margin-top: 20rpx;
}

.bind-card {
  border: 2rpx dashed #2E6E65;
}
