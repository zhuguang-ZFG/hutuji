@import "../../styles/weui-page.wxss";

.cell-input {
  width: 100%;
  font-size: 30rpx;
  color: #f2f4f8;
}

.log {
  background: #0b0c13;
  color: #00d1e5;
  padding: 24rpx 32rpx;
  font-size: 24rpx;
  font-family: monospace;
  white-space: pre-line;
  word-break: break-all;
}

.done-log {
  margin: 0;
  border-radius: 0;
  text-align: left;
}

.link-cell:active {
  background: rgba(0, 209, 229, 0.08);
}
