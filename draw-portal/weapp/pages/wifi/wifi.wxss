@import "../../styles/weui-page.wxss";

.cell-input {
  width: 100%;
  font-size: 30rpx;
  color: #4d3a46;
}

.log {
  background: #fff7ed;
  color: #b03f5a;
  padding: 24rpx 32rpx;
  font-size: 24rpx;
  font-family: monospace;
  white-space: pre-line;
  word-break: break-all;
}

.done-log {
  margin: 0;
  border-radius: 0;
  text-align: left;
}

.link-cell:active {
  background: rgba(216, 95, 123, 0.08);
}

.password-toggle { flex-shrink: 0; margin: 0 0 0 16rpx; background: transparent; color: #b03f5a; font-size: 25rpx; }
.password-toggle::after { border: none; }
