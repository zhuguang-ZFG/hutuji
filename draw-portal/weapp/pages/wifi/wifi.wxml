<view class="page">
  <block wx:if="{{step === 'scan'}}">
    <view class="hero">
      <view class="hero-brand">动力巢科技 · 小派</view>
      <view class="hero-title">给丹青连<span class="accent">家里 WiFi</span></view>
      <view class="hero-sub">对丹青说「配网」，屏幕出现二维码后扫它</view>
    </view>
    <view class="weui-btn-area">
      <button class="weui-btn weui-btn_primary" bindtap="onScanAp">扫屏幕配网码</button>
    </view>
    <view class="divider">
      <view class="divider-line"></view>
      <view class="divider-text">或</view>
      <view class="divider-line"></view>
    </view>
    <view class="weui-btn-area tight">
      <button class="weui-btn weui-btn_default" bindtap="onManualAp">手动输入设备热点名</button>
    </view>
  </block>

  <block wx:if="{{step === 'manual'}}">
    <view class="weui-cells__title">输入设备热点名</view>
    <view class="weui-cells__tips">丹青屏幕「配网模式」上显示的热点名</view>
    <view class="weui-cells">
      <view class="weui-cell">
        <view class="weui-cell__bd">
          <input class="cell-input" placeholder="设备热点名（屏幕上有）" value="{{apSsid}}" bindinput="onApInput" />
        </view>
      </view>
    </view>
    <view class="weui-btn-area">
      <button class="weui-btn weui-btn_primary" bindtap="onStart">下一步</button>
    </view>
    <view class="weui-cells__tips">配网时手机会先连到设备热点，断网几十秒属正常</view>
  </block>

  <block wx:if="{{step === 'aps'}}">
    <view class="weui-cells__title">点选家里 WiFi</view>
    <view class="weui-cells__tips">以下是丹青搜到的附近 WiFi</view>
    <view class="weui-cells">
      <view
        class="weui-cell link-cell"
        wx:for="{{apList}}"
        wx:key="ssid"
        data-ssid="{{item.ssid}}"
        bindtap="onPickAp"
      >
        <view class="weui-cell__bd">{{item.ssid}}</view>
        <view class="weui-cell__ft">{{item.authmode === 0 ? '开放' : '加密'}} ›</view>
      </view>
    </view>
    <view class="weui-btn-area">
      <button class="weui-btn weui-btn_default" bindtap="onManualSsid">找不到？手输 WiFi 名</button>
    </view>
  </block>

  <block wx:if="{{step === 'creds'}}">
    <view class="weui-cells__title">输入 WiFi 密码</view>
    <view class="weui-cells__tips">家里 WiFi：{{homeSsid || "（未选）"}}</view>
    <view class="weui-cells">
      <view class="weui-cell" wx:if="{{!wifiLocked}}">
        <view class="weui-cell__bd">
          <input class="cell-input" placeholder="家里 WiFi 名称" value="{{homeSsid}}" bindinput="onSsidInput" />
        </view>
      </view>
      <view class="weui-cell">
        <view class="weui-cell__bd">
          <input class="cell-input" placeholder="家里 WiFi 密码" password value="{{homePassword}}" bindinput="onPwdInput" focus="{{wifiLocked}}" />
        </view>
      </view>
    </view>
    <view class="weui-btn-area">
      <button class="weui-btn weui-btn_primary" bindtap="onSubmitCreds">一键配网</button>
    </view>
    <view class="weui-cells__tips">配网时手机连着设备热点，断网几十秒属正常</view>
    <view class="weui-btn-area tight" wx:if="{{deviceMac}}">
      <button class="weui-btn weui-btn_default" bindtap="onClaimOnly">其实已经配好网了？点这里直接绑定这台设备</button>
    </view>
  </block>

  <block wx:if="{{step === 'working'}}">
    <view class="weui-cells__title">配网中…</view>
    <view class="weui-cells">
      <view class="log">{{log}}</view>
    </view>
  </block>

  <block wx:if="{{step === 'done'}}">
    <view class="hero">
      <view class="hero-brand">动力巢科技 · 小派</view>
      <view class="hero-title">
        {{bindState === 'bound' ? '配网和绑定完成了' : '正在确认设备联网'}}
      </view>
      <view class="hero-sub">
        {{bindState === 'bound' ? '已绑定到你的账号，现在可以使用这台设备了' : (bindState === 'claiming' || bindState === 'waiting' ? '设备上线后会自动完成绑定，请稍候…' : '请根据下方提示继续')}}
      </view>
    </view>
    <view class="weui-cells" wx:if="{{log}}">
      <view class="log done-log">{{log}}</view>
    </view>
    <view class="weui-btn-area" wx:if="{{bindState === 'manual' && deviceMac}}">
      <button class="weui-btn weui-btn_primary" bindtap="onRetryBind">重试绑定</button>
      <button class="weui-btn weui-btn_default" bindtap="onEditWifi">修改 Wi-Fi 信息</button>
      <button class="weui-btn weui-btn_default" bindtap="openWifiSettings">打开手机 Wi-Fi 设置</button>
    </view>
    <view class="weui-btn-area" wx:if="{{bindState !== 'bound' && !deviceMac}}">
      <button class="weui-btn weui-btn_primary" bindtap="onGoBind">下一步：绑定设备</button>
    </view>
    <view class="weui-btn-area tight">
      <button class="weui-btn weui-btn_default" bindtap="onRestart">再配一台</button>
    </view>
  </block>
</view>
