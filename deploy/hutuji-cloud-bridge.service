[Unit]
Description=hutuji Xiaozhi MCP cloud bridge
Documentation=file:///opt/hutuji/docs/deployment.md
After=network-online.target hutuji-mcp.service
Wants=network-online.target
Requires=hutuji-mcp.service
# PartOf：hutuji-mcp stop/restart 时本服务一并 stop/restart。Requires= 只管启动
# 依赖、对 restart 不传播——运维单独 restart hutuji-mcp 后，本服务里的 mcp-proxy
# 会拿着已终止的 mcp-session-id 继续跑，每次工具调用都收 Session terminated
#（R10-BRG-01 的运维触发面）。桥接内已有同名判死重连，本键与之互为冗余：判死
# 要等第一次失败的调用触发，PartOf 在部署动作当下就把会话对齐。
PartOf=hutuji-mcp.service
# 配置错误（bridge.env 缺 MCP_ENDPOINT 或格式非法）时 main() 返回 1，配合
# [Service] 的 RestartSec=5 会无限每 5 秒重启刷日志：systemd 默认限流是 10 秒内
# 5 次，5 秒间隔永远触发不到。连接类故障不会退出进程（cloud_bridge.py 的
# run_forever 用 1→60s 指数退避在进程内重试），故这里只兜配置错误的日志噪声。
# 注意这两个键属 [Unit] 段，写在 [Service] 里会被静默忽略。
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=hutuji
Group=hutuji
WorkingDirectory=/opt/hutuji/mcp-server
EnvironmentFile=/etc/hutuji/bridge.env
Environment=HUTUJI_BRIDGE_READY_FILE=/run/hutuji/cloud-bridge.ready
ExecStart=/opt/hutuji/mcp-server/.venv/bin/python -m hutuji_mcp.cloud_bridge
Restart=on-failure
RestartSec=5
TimeoutStartSec=30

# 内存兜底，与 hutuji-mcp.service 同口径：把 OOM 的作用域从「整机」收到本 cgroup。
# 生产实测（2026-08-11）：整机 3911MB **无 swap**，本服务 cgroup 当前 59.1MB、
# 峰值 59.7MB（曲线基本平坦——它只中转 JSON-RPC，不碰图像/几何），原为 infinity；
# 进程树是 bridge 29.6MB + spawn 的 mcp-proxy 57.3MB，两者同属本 cgroup 一并计入。
# 取 256M：峰值的 4.3 倍。mcp-proxy 重连时若旧代理未死净而新代理已起，短暂并存
# 约 114MB 加 bridge 约 30MB ≈ 144MB，仍有余量；反过来给 512M 对一个峰值 60MB 的
# 服务几乎等于不设限，抓不住泄漏。本条要防的正是 mcp-proxy 的子进程生命周期问题
# （0.12.0 有社区稳定性报告：子进程僵死/堆积），那类泄漏在无上限时会挤垮整机，
# 而受害者由内核按 oom_score 挑——可能是 nginx 或 sshd 而非肇事者。
# 被 OOM 杀掉可自愈：Restart=on-failure 已在，且 [Unit] 的
# StartLimitIntervalSec=300 / StartLimitBurst=5 兜住反复重启刷日志。
MemoryMax=256M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RuntimeDirectory=hutuji
RuntimeDirectoryMode=0750

# 与 hutuji-mcp.service 同口径的纵深防御。本进程持有小智云凭据并起 mcp-proxy
# 子进程，被攻破后的出网能力必须收窄到必要协议族。
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
PrivateDevices=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete

[Install]
WantedBy=multi-user.target
