[Unit]
Description=hutuji MCP server (localhost only)
Documentation=file:///opt/hutuji/docs/deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hutuji
Group=hutuji
WorkingDirectory=/opt/hutuji/mcp-server
EnvironmentFile=/etc/hutuji/mcp.env
# 明确绑 loopback，避免 EnvironmentFile 缺失时误听 0.0.0.0
#
# --no-proxy-headers 是安全判据、不是性能选项，禁止删：uvicorn 默认
# proxy_headers=True，且 forwarded_allow_ips 默认值来自**环境变量**
# （uvicorn/config.py：`os.environ.get("FORWARDED_ALLOW_IPS", "127.0.0.1")`）。
# 本 unit 有 EnvironmentFile=/etc/hutuji/mcp.env，于是运维往那个文件加一行
# FORWARDED_ALLOW_IPS=* 就能静默放宽头信任，命令行没有任何东西压得住它。
# 而 ProxyHeadersMiddleware 被 uvicorn 包在**最外层**，会用 X-Forwarded-For
# 改写 ASGI scope["client"]——那正是 LoopbackOnlyMcpGuard 的唯一判据。
# 2026-08-11 本机实测（探针，用后即删）：trusted='*' + 公网对端 +
# 伪造 `X-Forwarded-For: 127.0.0.1` → 守卫放行 200，无鉴权 MCP 控制面裸曝；
# 默认 trusted='127.0.0.1' 时同样请求 404。关掉本开关后 Config.load() 的
# `if self.proxy_headers:` 直接不装该中间件，环境变量再怎么设都无效，
# scope["client"] 恒为真实 socket 对端——守卫 docstring 的「不可伪造」才真成立。
# 应用侧不消费转发来的客户端 IP（限速与日志都在 nginx 用 $hutuji_client_ip 做），
# 故关掉零功能损失。
ExecStart=/opt/hutuji/mcp-server/.venv/bin/python -m uvicorn hutuji_mcp.server:app --host 127.0.0.1 --port 8300 --no-proxy-headers
# 必须在与主进程相同的 systemd 沙箱里跑真实 vpype；服务外 preflight 覆盖不到 seccomp。
ExecStartPre=/opt/hutuji/mcp-server/.venv/bin/python -m hutuji_mcp.gcode_gen --self-test
# 位图路线的描摹重依赖（skimage/sknw/imageio）是延迟 import：缺失时 server 照样
# import 成功、服务照样 active、上面那条自检只覆盖 vpype 一半，于是「active + preflight
# 全绿 + 每次 hutuji_draw 都在描摹期炸」可同时成立（2026-08-09 本机实测复现）。这条
# 把它变成 fail-closed；且 skimage/scipy 的数值栈比 vpype 更宽，只有沙箱内真实调用
# 才能暴露 SystemCallFilter 漏项（参见上面 mbind 的前车之鉴）。自检不碰网络。
ExecStartPre=/opt/hutuji/mcp-server/.venv/bin/python -m hutuji_mcp.bitmap_svg --self-test
Restart=on-failure
RestartSec=5
TimeoutStartSec=30

# 应用树由 root 维护；服务仅需创建和清理生成产物。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hutuji/mcp-server/output

# 纵深防御：本进程会用 vpype/vpype-gcode 的 C 扩展路径解析 LLM 生成的 SVG，
# 且经 nginx /files/ 间接面向公网请求。解析链一旦有内存安全问题，下面这些
# 限制把「拿到 shell」与「任意出网 / 改内核可调项」隔开。
# AF_UNIX 必须保留（loopback 之外还有 DNS resolver 的本地 socket）。
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
PrivateDevices=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @obsolete
# vpype 的数值依赖会调用 mbind；其余 @resources 调用仍逐项拒绝。
SystemCallFilter=~ioprio_set migrate_pages move_pages nice sched_setaffinity sched_setattr sched_setparam sched_setscheduler set_mempolicy set_mempolicy_home_node setpriority setrlimit

[Install]
WantedBy=multi-user.target
