[Unit]
Description=hutuji draw-worker (single instance, optional)
After=network-online.target redis.service
Wants=network-online.target
OnFailure=hutuji-notify@%n.service

[Service]
Type=simple
User=hutuji
Group=hutuji
WorkingDirectory=/opt/hutuji/mcp-server
Environment=PYTHONPATH=/opt/hutuji/mcp-server
EnvironmentFile=-/etc/hutuji/mcp.env
ExecStart=/opt/hutuji/mcp-server/.venv/bin/python -m hutuji_mcp.draw_worker
Restart=on-failure
RestartSec=5
# 与 @.service 同口径的优雅停机宽限（理由见 @.service 注释）。
TimeoutStopSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hutuji/mcp-server/output
MemoryMax=1G
# 与 hutuji-draw-worker@.service 同口径：不设 SystemCallFilter（clone3 实测见 @.service 注释）。

[Install]
WantedBy=multi-user.target
