# 复制为 /etc/hutuji/kb-admin.env 后填写；chmod 600。仅 hutuji-kb-admin.service 使用，禁止提交真实值。

# 登录密码（少人售后单密码即可）
KB_ADMIN_PASSWORD=change-me

# 会话签名密钥：生产必须显式设置随机 hex（openssl rand -hex 32）。
# 留空时进程每次重启都会重新生成，已登录 cookie 全部失效。
KB_ADMIN_SESSION_SECRET=generate-random-hex

# SQLite 编辑库（目录须存在且 hutuji 用户可写）
KB_ADMIN_DB=/var/lib/hutuji/kb-admin/data.db

# 小智知识库容器 id（控制台可见；示例 71153 请换成现网 id）
KB_ADMIN_KB_ID=71153

# 发布正文固定块：前言与只读附录（不进 FAQ 表，防契约被误删）
KB_ADMIN_PREFACE_PATH=/opt/hutuji/docs/xiaozhi-agent/kb-preface.md
KB_ADMIN_APPENDIX_PATH=/opt/hutuji/docs/xiaozhi-agent/kb-appendix.md

# 可选：从仓内 knowledge-base.md 一次性/重复导入候选 FAQ
KB_ADMIN_IMPORT_MD=/opt/hutuji/docs/xiaozhi-agent/knowledge-base.md

# 小智控制台 JWT（浏览器 localStorage token；与设备「主题配置」消息 token 不是同一个）
# 会被服务端定期作废；2026-08-31 起主节点看门狗可自动续期（凭据见
# env.xiaozhi-login.example），kb-admin 重启后从本文件重读，仍须随 mcp.env 同源更新
XIAOZHI_TOKEN=

# 下列两项须与 unit 命令行一致；-m uvicorn 不读本字段，但 load_config 会校验 loopback。
KB_ADMIN_HOST=127.0.0.1
KB_ADMIN_PORT=8301
