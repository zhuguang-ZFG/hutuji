# 复制为 /etc/hutuji/mcp.env 后填写；chmod 600。允许空行、注释与成对单/双引号；
# 同一变量若重复，systemd 与 preflight 均以最后一次赋值为准。仅 hutuji-mcp.service 使用，禁止提交真实值。

# 监听面的真值是 hutuji-mcp.service 的 `--host 127.0.0.1 --port 8300`：生产用
# `-m uvicorn hutuji_mcp.server:app` 启动，**不读**下面两行。它们仍必须与 unit 一致
# ——config.py 在 import 期校验 HUTUJI_HOST 必为 loopback，写成 0.0.0.0 会让服务
# 启动即失败（此前是静默忽略，让人误以为改了监听面）。
HUTUJI_HOST=127.0.0.1
HUTUJI_PORT=8300
HUTUJI_OUTPUT_DIR=/opt/hutuji/mcp-server/output
HUTUJI_OUTPUT_TTL_SECONDS=600
# 多页文章（hutuji_write）错峰 TTL 每页预算，30..3600。设备逐页串行「下载→灌流→
# 换纸」，实测一页 ≈125s；若 N 页共用一个 600s 窗口，第 6 页起必然过期 404。第 i
# 页（i≥1）的 created 前移 i×本值 → 窗口 = TTL + i×本值（第 1 页不动）。见 protocol §4.2。
HUTUJI_PAGE_TTL_BUDGET_SECONDS=300
# S3 下载前缀：生产只允许 HTTPS 默认 443（可显式写 :443）；明文只允许 Tunnel 的本机回源。
HUTUJI_PUBLIC_BASE_URL=https://hutuji.donglicao.com

# 绘图 LLM（OpenAI 兼容）。当前生产使用 Agnes；密钥只填入机上 600 权限文件。
HUTUJI_LLM_BASE_URL=https://api.agnes-ai.cn/v1
HUTUJI_LLM_API_KEY=REPLACE_ME
HUTUJI_LLM_MODEL=agnes-2.5-flash
# 文生图模型（hutuji_draw 位图路线，2026-08-09 起为现行路线；与 LLM 共用上面的端点与 key）
HUTUJI_IMAGE_MODEL=agnes-image-2.1-flash
# 可选商汤 U1 Fast PNG 主后端；三项全注释=保持 Agnes。启用时必须三项齐全，
# key 只写生产 600 权限文件。启用后商汤 / Agnes / imagefree 三路并发对冲
# （谁先出图用谁），不改变中心线描摹链。
# HUTUJI_SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
# HUTUJI_SENSENOVA_API_KEY=REPLACE_ME
# HUTUJI_SENSENOVA_IMAGE_MODEL=sensenova-u1-fast
# imagefree 免 key racer（商汤启用时参与对冲；否则 Agnes 失败后顺序兜底）。
# 默认即下值，无需填写；置空=禁用。
# HUTUJI_IMAGE_FALLBACK_URL=https://imagefree.tingfengai.art/v1/generate

# 可选 SiliconFlow：单 key 即启用 schnell + 可图 Kolors（已备案
# Beijing-KeTu-202404280003）双 racer 参与对冲；key 只写生产 600 权限文件。
# HUTUJI_SILICONFLOW_API_KEY=REPLACE_ME

# 激活码中转（/register → 小智控制台代绑，2026-08-20 起）：两项必须同时配置或
# 同时留空（留空=中转禁用，端点回 503，设备走屏显激活码人工兜底）。
# token 是小智控制台 JWT（浏览器 localStorage.getItem('token')），会被服务端
# 定期作废——失效后 /register 上行 401，日志点名 console token rejected。
# 2026-08-31 起主节点看门狗检出作废会自动 OCR 登录续期（凭据在
# /etc/hutuji/xiaozhi-login.env，见 env.xiaozhi-login.example），自动失败才回
# 人工 refresh-xiaozhi-token.sh；agent id 即呼图机智能体（当前 2094251）。
# HUTUJI_XIAOZHI_TOKEN=REPLACE_ME
# HUTUJI_XIAOZHI_AGENT_ID=2094251
# HUTUJI_XIAOZHI_API_BASE=https://xiaozhi.me/api

# 服务端链式调用（2026-08-24 P1-3）：draw 生成完成后服务端经官方
# /messaging/device/tools/call 主动调设备 hutuji.draw（双参数），消灭云端第二步
# 漏调「纸不动」。token 来自设备「自定义主题」URL 的 token 参数（与控制台 JWT
# 不是一个），泄露面同凭据管理；留空 = 禁用，云端两步衔接仍是合法回落。
# HUTUJI_XIAOZHI_DEVICE_TOKEN=REPLACE_ME

# 精选单线 SVG 库（2026-08-26 暗部署起；2026-08-27 达标优先路由上线）：设
# HUTUJI_CURATED_DIR 后，类目 manifest count≥n_min 即优先出 curated（单类目
# 达标，不要求全集 ready）；空 = 关闭（落 AI 链）。QD 已于 2026-08-27 退役，
# REPLACE_QD 全集 flip 已被优先路由吸收，本项留作休眠/回滚语义。
# HUTUJI_CURATED_DIR=/opt/hutuji/curated
# HUTUJI_CURATED_REPLACE_QD=0

# AI 纸面风险闸（2026-08-27）：AI 位图链 G-code 画糊风险统计拒收重画，最多 3 轮；
# QD/curated 不经闸。=0 关闭 enforce（秒级回滚，shadow 统计仍记日志）。
# HUTUJI_PAPER_RISK_GATE=1

# 异步生成+完成推送（2026-08-28 决策）：默认 0 同步；设 1 且已配
# HUTUJI_XIAOZHI_DEVICE_TOKEN 时 hutuji_draw 立即回 {"accepted":true} 并在后台
# 完成后经设备 API 自动推送到预览（无需重复调用）；未配 token 时回落同步。
# HUTUJI_DRAW_ASYNC=0

# 课堂级并发生图闸（2026-08-29 拍板）：单进程 DrawLimiter + vpype。
# 默认即课堂级；改完须 restart hutuji-mcp（京东云热备同步写一份）。
# 禁止靠多 uvicorn --workers「翻倍」——每进程各一份内存闸会静默放大。
HUTUJI_DRAW_MAX_CONCURRENT=8
HUTUJI_DRAW_PER_SECOND=4
HUTUJI_DRAW_PER_MINUTE=120
HUTUJI_VPYPE_MAX_CONCURRENT=6

# Redis 绘图队列（高并发 Phase-1）：设 redis:// 后 MCP 只入队，由 hutuji-draw-worker 消费。
# 留空=现网进程内 asyncio 任务。测试可用 memory://（单进程，勿上生产）。
# HUTUJI_DRAW_QUEUE_URL=redis://127.0.0.1:6379/0
# HUTUJI_DRAW_QUEUE_MAX_DEPTH=200
# HUTUJI_DRAW_ENQUEUE_PER_SECOND=10
# HUTUJI_DRAW_PER_DEVICE_MINUTE=6

# 高并发对冲降档：>0 时每轮最多启用 N 个生图 racer（0=不限制，现网默认）
# HUTUJI_DRAW_RACER_MAX=2

# 产物存储：local=本机 output/；oss=阿里云 OSS（多 worker 须配合下方 OSS 变量）
# HUTUJI_OUTPUT_BACKEND=local
# HUTUJI_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# HUTUJI_OSS_BUCKET=hutuji-draw
# HUTUJI_OSS_ACCESS_KEY_ID=REPLACE_ME
# HUTUJI_OSS_ACCESS_KEY_SECRET=REPLACE_ME
# HUTUJI_OSS_PREFIX=draw

# Phase-3：Postgres 任务账本（空=禁用；与 draw-admin 可共用 RDS）
# HUTUJI_PG_DSN=postgresql://hutuji:REPLACE_ME@127.0.0.1:5432/hutuji_ops
# HUTUJI_PG_RETENTION_DAYS=30

# Phase-3：生图通道熔断（3a 默认 shadow：HUTUJI_BREAKER_ENFORCE=0 只记事件不过滤）
# HUTUJI_BREAKER_ENFORCE=0
# HUTUJI_BREAKER_WINDOW_SEC=60
# HUTUJI_BREAKER_FAIL_RATIO=0.5
# HUTUJI_BREAKER_OPEN_SEC=120
# HUTUJI_BREAKER_CONSECUTIVE_FAIL=3
# HUTUJI_METRICS_INTERVAL_SEC=15

# Phase-3c：CDN 在 DNS 层透明加速 /files/（MCP 仍返回 PUBLIC_BASE_URL 路径）
# HUTUJI_CDN_ENABLED=0

# usage 事件写入 draw-portal（与 draw-portal.env 的 DRAW_PORTAL_USAGE_INGEST_SECRET 相同）
HUTUJI_USAGE_INGEST_URL=http://127.0.0.1:8302/api/internal/usage
HUTUJI_USAGE_INGEST_SECRET=

# 运营后台生图通道 + 限流（internal API；阿里云本机用 127.0.0.1，京东云填阿里云 VPC 内网 IP）
# HUTUJI_MCP_SETTINGS_URL=http://10.x.x.x:8302/api/internal/mcp-settings
# 未设置时由 HUTUJI_USAGE_INGEST_URL 推导为 .../mcp-settings
