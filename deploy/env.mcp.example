# 复制为 /etc/hutuji/mcp.env 后填写；chmod 600
# 仅 hutuji-mcp.service 使用。禁止把填好的文件提交进 git。

HUTUJI_HOST=127.0.0.1
HUTUJI_PORT=8300
HUTUJI_OUTPUT_DIR=/opt/hutuji/mcp-server/output
HUTUJI_OUTPUT_TTL_SECONDS=600
# S3 下载前缀：经 nginx 的公网地址。自签阶段用 http；正式证后改 https
HUTUJI_PUBLIC_BASE_URL=http://117.72.118.95

# 绘图 LLM（OpenAI 兼容）。京东云实测：FreeModel 余额不足时用 llm7。
# HUTUJI_LLM_BASE_URL=https://api.freemodel.dev/v1
# HUTUJI_LLM_MODEL=auto
HUTUJI_LLM_BASE_URL=https://api.llm7.io/v1
HUTUJI_LLM_API_KEY=REPLACE_ME
HUTUJI_LLM_MODEL=default
