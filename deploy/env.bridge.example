# 复制为 /etc/hutuji/bridge.env 后填写；chmod 600
# 仅 hutuji-cloud-bridge.service 使用。禁止把填好的文件提交进 git。
# MCP_ENDPOINT 不要放进 mcp.env，减少泄露面。

HUTUJI_LOCAL_MCP_URL=http://127.0.0.1:8300/mcp

# 任一时刻只允许一个节点连云；阿里云主节点设 1，京东云热备保持 0。
# unit 默认 0。仅 disable 无法阻止 MCP 的 PartOf restart 传播拉起 bridge。
HUTUJI_BRIDGE_ACTIVE=0

# 从小智控制台 → 智能体 → MCP 接入点 复制整段 wss://…
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=REPLACE_ME
