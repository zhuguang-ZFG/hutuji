[Unit]
Description=hutuji draw-worker instance %i (Redis queue consumer)
After=network-online.target redis.service
Wants=network-online.target
PartOf=hutuji-draw-worker.target

[Service]
Type=simple
User=hutuji
Group=hutuji
WorkingDirectory=/opt/hutuji/mcp-server
Environment=PYTHONPATH=/opt/hutuji/mcp-server
Environment=HUTUJI_DRAW_WORKER_INSTANCE=%i
EnvironmentFile=-/etc/hutuji/mcp.env
ExecStart=/opt/hutuji/mcp-server/.venv/bin/python -m hutuji_mcp.draw_worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hutuji/mcp-server/output
MemoryMax=1G
# draw-worker 走 asyncio.create_subprocess_exec（Linux 上 clone3）。阿里云实测 systemd
# 较旧时 SystemCallFilter 白名单即显式放行 mbind/clone3/@process 仍 SIGSYS(434)；
# MCP ExecStartPre 的同步 subprocess.run 不受影响，故此前 preflight 生成链自检通过
# 但队列 worker 全挂。本进程不直曝公网，仅消费本机 Redis，故不设 SystemCallFilter。

[Install]
WantedBy=hutuji-draw-worker.target
