# 小智控制台账号凭据——仅供 xiaozhi-token-auto.py 自动续期使用。
# 落点 /etc/hutuji/xiaozhi-login.env，chmod 600，root 持有；**严禁入库**。
#
# 风险口径（2026-08-31 用户拍板「全自动」）：口令比 JWT 多「过期后无限重签」
# 能力，请使用强独立口令；作废是事件性的，自动登录仅在看门狗检出 401/403
# 时触发（翻转即时一次 + 持续失效每小时一次），不轮询、不抢占浏览器会话。
#
# 只部署在阿里云主节点：双节点同时自动登录可能互踢会话；京东云热备保持
# 看门狗报警 + 人工 refresh-xiaozhi-token.sh。

XIAOZHI_LOGIN_USERNAME=REPLACE_ME
XIAOZHI_LOGIN_PASSWORD=REPLACE_ME

# 可选：API 基址覆盖（默认 https://xiaozhi.me/api）
# XIAOZHI_API_BASE=https://xiaozhi.me/api
