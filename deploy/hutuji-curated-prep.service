[Unit]
Description=hutuji curated SVG library offline fill
Documentation=file:///opt/hutuji/mcp-server/hutuji_mcp/CURATED-ATTRIBUTION.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=hutuji
Group=hutuji
WorkingDirectory=/opt/hutuji/mcp-server
EnvironmentFile=/etc/hutuji/mcp.env
Environment=PYTHONUNBUFFERED=1
# 离线灌库：断点续跑；类失败非 0 退出时 on-failure 便于 API 抖动后自动续填。
ExecStart=/opt/hutuji/mcp-server/.venv/bin/python scripts/curated_prep.py --out /opt/hutuji/curated --audit-dir /opt/hutuji/curated-audit --per-category 50 --n-min 30 --max-attempts-per-slot 5
Restart=on-failure
RestartSec=90
Nice=10
CPUQuota=50%
MemoryMax=1536M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hutuji/curated /opt/hutuji/curated-audit
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
