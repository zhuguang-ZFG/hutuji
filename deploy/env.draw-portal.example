# draw-portal 环境模板 → /etc/hutuji/draw-portal.env（chmod 600）
#
# 生成 TOKEN_CIPHER_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# 生成 SESSION_SECRET:
#   python -c "import secrets; print(secrets.token_hex(32))"

DRAW_PORTAL_DB=/var/lib/hutuji/draw-portal/data.db
DRAW_PORTAL_DATA_DIR=/var/lib/hutuji/draw-portal
DRAW_PORTAL_SESSION_SECRET=
DRAW_PORTAL_TOKEN_CIPHER_KEY=
DRAW_PORTAL_XIAOZHI_API_BASE=https://xiaozhi.me/api
DRAW_PORTAL_HOST=127.0.0.1
DRAW_PORTAL_PORT=8302
DRAW_PORTAL_BIND_TTL_SECONDS=600
DRAW_PORTAL_SAVED_PREVIEW_LIMIT=50
DRAW_PORTAL_PUBLIC_BASE_URL=https://hutuji.donglicao.com
DRAW_PORTAL_MCP_OUTPUT_DIR=/opt/hutuji/mcp-server/output

# 邮箱验证码注册（SMTP；生产勿开 DEV_EXPOSE）
DRAW_PORTAL_SMTP_HOST=
DRAW_PORTAL_SMTP_PORT=587
DRAW_PORTAL_SMTP_USER=
DRAW_PORTAL_SMTP_PASSWORD=
DRAW_PORTAL_SMTP_FROM=
DRAW_PORTAL_EMAIL_CODE_TTL_SECONDS=600
DRAW_PORTAL_EMAIL_DEV_EXPOSE_CODE=0

# 对话采集 + MCP usage 写入（链 2 internal API 密钥；与 mcp.env 的 HUTUJI_USAGE_INGEST_SECRET 相同）
DRAW_PORTAL_USAGE_INGEST_SECRET=
DRAW_PORTAL_CONVERSATION_RETENTION_DAYS=90
DRAW_PORTAL_CONVERSATION_MAX_CONTENT=500
